 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/match1949285date2026vnative.htm" target="_blank" weibo="" mode="1,2">晋级欧联四强！维拉4-0总比分7-1博洛尼亚将战森林 沃特金斯破门</a></p><div class="img_wrap" data-ratio="0.66" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949285_1776372595_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.66" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.66" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949285_1776372595_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949285_1776372595_gray.jpeg"> </div><p>沃特金斯、布恩迪亚、孔萨破门，罗杰斯建功+失点；维拉晋级四强将迎战诺丁汉森林。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/match1949283date2026vnative.htm" target="_blank" weibo="" mode="1,2">挺进四强！森林1-0波尔图总比分2-1晋级将战维拉 吉布斯-怀特建功</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949283_1776372192_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949283_1776372192_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949283_1776372192_gray.jpeg"> </div><p>吉布斯-怀特制胜，贝德纳雷克蹬踏伍德吃直红，；诺丁汉森林晋级欧联杯四强，他们在半决赛的对手将是阿斯顿维拉。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/match1949287date2026vnative.htm" target="_blank" weibo="" mode="1,2">进四强！水晶宫1-2佛罗伦萨总比分4-2晋级 伊斯梅拉·萨尔破门</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949287_1776372263_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949287_1776372263_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260417/zhanbao_image_1949287_1776372263_gray.jpeg"> </div><p>伊斯梅拉·萨尔破门，曼德拉戈拉造点，古德蒙德森点射，恩多尔制胜；水晶宫1-2佛罗伦萨总比分4-2晋级欧协联四强，将对阵顿涅茨克矿工。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/69e149d97d0a2native.htm" target="_blank" weibo="" mode="1,2">欧联杯-安东尼破门 贝蒂斯主场被布拉加让二追四 后者将战弗赖堡</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/news/day_260417/202604170501573191.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260417/202604170501573191.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260417/202604170501573191.jpg"> </div><p>本轮欧联杯八强战完赛一场，首回合客场1-1战平的贝蒂斯，回到主场被布拉加2-4大逆转。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/69e10f5533f14native.htm" target="_blank" weibo="" mode="1,2">再次申诉！巴萨官方：欧冠两回合比赛遭多次误判，VAR未有效介入</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260417/202604170104038852.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260417/202604170104038852.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260417/202604170104038852.jpg"> </div><p>巴萨官方公告，俱乐部就欧冠四分之一决赛的裁判表现向欧足联提出申诉。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-16/69e0faf76cf6bnative.htm" target="_blank" weibo="" mode="1,2">梅老板！官方：梅西收购西班牙第5级别队科内利亚 李昊曾效力该队</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260416/202604162327344586.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260416/202604162327344586.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260416/202604162327344586.jpg"> </div><p>西班牙第五级别联赛球队科内利亚官方宣布，梅西完成了对球队的收购，正式成为这支球队的老板。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/69e1077461a44native.htm" target="_blank" weibo="" mode="1,2">英超2队！欧联杯半决赛对阵：维拉vs森林，布拉加vs弗赖堡</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_260417/202604170548515768.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260417/202604170548515768.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260417/202604170548515768.jpg"> </div><p>欧联杯1/4决赛次回合结束，维拉、弗赖堡、诺丁汉森林、布拉加晋级四强。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/69e151d3904ebnative.htm" target="_blank" weibo="" mode="1,2">欧协联半决赛对阵：顿涅茨克矿工vs水晶宫 巴列卡诺v斯特拉斯堡</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/news/day_260417/202604170520175196.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260417/202604170520175196.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260417/202604170520175196.jpg"> </div><p>欧协联八强战已经完赛，半决赛对阵也随之出炉。水晶宫、巴列卡诺、斯特拉斯、顿涅茨克矿工晋级。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-17/69e107ff153e5native.htm" target="_blank" weibo="" mode="1,2">意甲全军覆没！欧战4强分布：英超4队，西甲、德甲、法甲各2队</a></p><div class="img_wrap" data-ratio="1.9" data="https://tu.duoduocdn.com/uploads/day_240315/65f329e241d0d.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.9" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.9" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_240315/65f329e241d0d.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_240315/65f329e241d0d.jpg"> </div><p><span 