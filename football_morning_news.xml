        $(".img_wrap").each(function(i){                 if($(this).attr('type')=='IMG'){                     var img = $(this).find('img:eq(0)');                     var ratio = $(this).attr("data-ratio");                     if(ratio){                         $(this).css({                             width:'100%',                             height:0,                            'padding-top':100/ratio+'%'                         }).find(".play_btn").css({                             top:0,                             height:'100%'                         });                         img.attr('src', img.attr('t-rc')).on("load",function(){                           $(this).css({'padding-top':'0'}).find(".play_btn").hide();                         }.bind(this));                     }else{                       $(this).css("width", 'auto');                       $(this).css("height", 'auto');                       $(this).css("background", 'none');                       $(this).removeClass("img_wrap");                       $(this).find('.play_btn').hide();                       img.attr('src', img.attr('t-rc'));                    }                 }             }); 		} 	}  	function get_op(img_op,platform){ 		img_op_arr = img_op.split('|'); 		if(img_op_arr.length!=4)return 5; 		switch (platform){             case 'android' :                 value = img_op_arr[0].split('_');                 break;             case 'ios' :                 value = img_op_arr[1].split('_');                 break;             case 'wap' :                 value = img_op_arr[2].split('_');                 break;             case 'pc' :                 value = img_op_arr[3].split('_');                 break;             default :                 value = [5,''];         }         return value[0]; 	}  	function get_img_op_attr(img_ele,platform){ 		if(platform=='android'){ 			if(window.zhibo8OpenImage && window.zhibo8OpenImage.openInnerExplorerBrowser){ 				op_value = img_ele.attr('img_op_new')