 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-22/match2067646date2026vnative.htm" target="_blank" weibo="" mode="1,2">揭幕战告捷！阿森纳3-0完胜考文垂 措利斯两度策动萨卡哈弗茨破门</a></p><div class="img_wrap" data-ratio="0.67" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260822/zhanbao_image_2067646_1787344639_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.67" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260822/zhanbao_image_2067646_1787344639_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260822/zhanbao_image_2067646_1787344639_gray.jpeg"> </div><p>新援措利斯制造两球，厄德高、哈弗茨、萨卡破门，阿森纳3-0考文垂拿下英超揭幕战。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-22/match2119560date2026vnative.htm" target="_blank" weibo="" mode="1,2">977球！胜利4-0利雅得体育 C罗新赛季首秀即破门 菲利克斯3场4球</a></p><div class="img_wrap" data-ratio="0.59" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260822/zhanbao_image_2119560_1787335543_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.59" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.59" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260822/zhanbao_image_2119560_1787335543_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260822/zhanbao_image_2119560_1787335543_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">C罗第62分钟替补登场，上演新赛季首秀，打进生涯第977球；利雅得胜利4-0完胜利雅得体育。</span></p><p><strong>【赛后声音】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-22/6a88ce5731db8native.htm" target="_blank" weibo="" mode="1,2">阿尔特塔：对现有阵容非常满意 球场氛围好？等以后输球再看看</a></p><div class="img_wrap" data-ratio="1.57" data="https://tu.duoduocdn.com/uploads/day_260816/6a81dc58e6276_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.57" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.57" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260816/6a81dc58e6276.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260816/6a81dc58e6276.jpg"> </div><p><span style="color: rgb(0, 0, 0);">阿森纳在英超揭幕战中3-0击败考文垂，主帅阿尔特塔在赛后新闻发布会上回答了记者提问。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-22/6a88d5944559anative.htm" target="_blank" weibo="" mode="1,2">兰帕德：对阵阿森纳0-3不会定义我们赛季，但绝对会吸取教训</a></p><div class="img_wrap" data-ratio="1.67" data="https://tu.duoduocdn.com/uploads/news/day_260822/202608220654419740.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.67" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260822/202608220654419740.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260822/202608220654419740.jpg"> </div><p><span style="color: rgb(0, 0, 0);">考文垂在英超揭幕战中0-3客场不敌阿森纳，主帅兰帕德在赛后发布会谈到了本场比赛，他指出球队会吸取本场比赛的教训。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-22/6a88ca309877fnative.htm" target="_blank" weibo="" mode="1,2">厄德高：上赛季对我来说很艰难，有时候伤没好也要上，现在好多了</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/day_260822/202608220559275386.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.78" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.78" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260822/202608220559275386_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260822/202608220559275386_720.jpg"> </div><p><span style="color: rgb(0, 0, 0);">26/27赛季英超揭幕战，阿森纳主场3-0轻取考文垂，赛后阿森纳队长厄德高接受采访。</span></p><p><strong>【其他足球动态】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-22/6a889fbbbe2a4native.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺：曼联敲定布莱顿22岁中场巴莱巴，转会总价7000万镑</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260822/202608220300323243.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260822/202608220300323243_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260822/202608220300323243_720.jpg"> </div><p><span style="color: rgb(0, 0, 0);">罗马诺以标志性的here we go确认，曼联与布莱顿就签下巴莱巴达协议，总价7000万英镑！</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-21/6a8859e3b696bnative.htm" target="_blank" weibo="" mode="1,2">FIFA官方公布世界杯决赛处罚：帕雷德斯禁赛10场、莫利纳禁7场</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260821/202608212237401110.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260821/202608212237401110.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260821/202608212237401110.jpg"> </div><p><span style="color: rgb(0, 0, 0);">国际足联官方发布了世界杯决赛赛后冲突事件的禁赛处罚，帕雷德斯禁10场，莫利纳禁7场，阿根廷足协遭罚款。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-21/6a880ccd60ca4native.htm" target="_blank" weibo="" mode="1,2">后防+1！官方：阿森纳签下28岁维拉后卫孔萨，转会费总价5500万镑</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260821/202608211636235296.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260821/202608211636235296.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260821/202608211636235296.jpg"> </div><p><span style="color: rgb(0, 0, 0);">官方消息，阿森纳签下28岁阿斯顿维拉后卫孔萨，据悉转会费总价5500万镑，双方签约5年，孔萨将在阿森纳身穿15号球衣。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-22/6a8896aaac3e1native.htm" target="_blank" weibo="" mode="1,2">三斯国际！官方：国米签下利物浦中场琼斯，转会费总价3500万欧</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260821/202608212132198126.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 1