 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【欧冠联赛阶段抽签出炉】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a8f36b730d3dnative.htm" target="_blank" weibo="" mode="1,2">⚔️欧冠联赛阶段抽签：皇马碰枪手！曼城遇巴黎巴萨，曼联踢拜仁</a></p><div class="img_wrap" data-ratio="0.46" data="https://tu.duoduocdn.com/uploads/day_260828/202608280302033023_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.46" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.46" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260828/202608280302033023_1280.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260828/202608280302033023_1280.jpg"> </div><p>26/27赛季欧冠联赛抽签仪式结束，联赛阶段对阵结果全部出炉。皇马联赛阶段遭遇国米、阿森纳；曼城将对阵巴黎、巴萨；曼联将对阵拜仁、马竞、罗马等队。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a90685840279native.htm" target="_blank" weibo="" mode="1,2">阿森纳欧冠联赛阶段：碰皇马、拜仁、多特、那不勒斯等8队</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a906afc88e95native.htm" target="_blank" weibo="" mode="1,2">曼联欧冠联赛阶段：碰拜仁、马竞、罗马、莱比锡等8队</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a905e3bae206native.htm" target="_blank" weibo="" mode="1,2">皇马欧冠联赛阶段：国米、阿森纳、罗马、莱比锡、矿工等8队</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a90675c47c66native.htm" target="_blank" weibo="" mode="1,2">巴萨欧冠联赛阶段对手：曼城、巴黎、维拉、科莫、葡体等8队</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a90ab7393fa0native.htm" target="_blank" weibo="" mode="1,2">欧冠最新夺冠赔率：巴黎领跑，枪萨仁并列第2，皇马第5，曼联第8</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_230316/64120712843ad.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_230316/64120712843ad.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_230316/64120712843ad.jpg"> </div><p>26/27赛季欧冠联赛阶段抽签结束，最新夺冠赔率出炉，巴黎依然是最大热门。</p><p><strong>【战报新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/match2075408date2026vnative.htm" target="_blank" weibo="" mode="1,2">两连胜！巴萨2-0毕巴 拉菲尼亚费尔明破门亚马尔失良机罗德里首秀</a></p><div class="img_wrap" data-ratio="0.69" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260828/zhanbao_image_2075408_1787864085_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.69" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.69" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260828/zhanbao_image_2075408_1787864085_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260828/zhanbao_image_2075408_1787864085_gray.jpeg"> </div><p>拉菲尼亚、费尔明2场3球，巴萨新赛季联赛2连胜；佩德里献助攻，罗德里替补上演首秀，亚马尔失良机。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a90a688d221cnative.htm" target="_blank" weibo="" mode="1,2">西甲积分榜：巴萨2连胜凭借净胜球优势领跑，与皇马等3队同积6分</a></p><div class="img_wrap" data-ratio="0.36" data="https://tu.duoduocdn.com/uploads/day_260828/202608280506453986.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.36" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.36" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260828/202608280506453986_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260828/202608280506453986_720.jpg"> </div><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/match2138372date2026vnative.htm" target="_blank" weibo="" mode="1,2">联赛杯-切尔西2-0卢顿 35岁维尔贝克蓝军处子球 埃斯特旺造乌龙</a></p><div class="img_wrap" data-ratio="0.69" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260828/zhanbao_image_2138372_1787861381_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.69" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.69" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260828/zhanbao_image_2138372_1787861381_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260828/zhanbao_image_2138372_1787861381_gray.jpeg"> </div><p>35岁维尔贝克斩获蓝军生涯处子球，埃斯特旺造乌龙，罗杰斯中柱；切尔西晋级联赛杯下一轮，对手是利兹联。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a907aace383fnative.htm" target="_blank" weibo="" mode="1,2">Here We Go！罗马诺：切尔西签33岁维拉门将大马丁 转会费750万镑</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260828/202608280204047874_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260828/202608280204047874_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260828/202608280204047874_720.jpg"> </div><p>罗马诺以标志性的“Here We Go”确认，切尔西将签下阿根廷门将达米安·马丁内斯，转会费750万英镑（约875万欧）。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-28/6a905bbb4e5b5native.htm" target="_blank" weibo="" mode="1,2">Here we go！罗马诺：维拉6500万镑签下25岁切尔西前锋杰克逊</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260828/202608280011148110.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" s