 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/match1713692date2026vnative.htm" target="_blank" weibo="" mode="1,2">少赛1场距枪手6分！曼城3-0切尔西 奥赖利多库破门谢尔基两助攻</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1713692_1776015779_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1713692_1776015779_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1713692_1776015779_gray.jpeg"> </div><p>曼城少赛一轮落后榜首6分！切尔西落后欧冠区4分；谢尔基2助，奥赖利进球后伤退，多库、格伊建功。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-12/match1713697date2026vnative.htm" target="_blank" weibo="" mode="1,2">14轮不胜！热刺0-1桑德兰距保级区2分 穆基勒制胜罗梅罗伤退痛哭</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260412/zhanbao_image_1713697_1776004925_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260412/zhanbao_image_1713697_1776004925_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260412/zhanbao_image_1713697_1776004925_gray.jpeg"> </div><p>热刺英超14轮不胜+仍落后保级区2分，德泽尔比首秀开门黑，穆基勒远射折射制胜，罗梅罗伤退痛哭。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/match1711016date2026vnative.htm" target="_blank" weibo="" mode="1,2">让二追四！国米4-3逆转客胜科莫 小图拉姆、邓弗里斯双响帕斯建功</a></p><div class="img_wrap" data-ratio="0.69" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1711016_1776026170_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.69" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.69" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1711016_1776026170_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1711016_1776026170_gray.jpeg"> </div><p>国米剩6轮9分优势领跑，图拉姆、邓弗里斯双响，帕斯破门+造点；科莫7轮不败遭终结。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/match1741436date2026vnative.htm" target="_blank" weibo="" mode="1,2">先赛距榜首4分！本菲卡2-0葡萄牙国民 谢尔德鲁普闪击+造点</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1741436_1776019055_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1741436_1776019055_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260413/zhanbao_image_1741436_1776019055_gray.jpeg"> </div><p>普雷斯蒂安尼2助，谢尔德鲁普闪击+造点，拉法·席尔瓦破门，帕夫利季斯失点，本菲卡先赛距榜首4分。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbaf29b1453native.htm" target="_blank" weibo="" mode="1,2">🔥英超积分榜：曼城少赛一轮落后枪手6分！切尔西落后欧冠区4分</a></p><div class="img_wrap" data-ratio="0.36" data="https://tu.duoduocdn.com/uploads/day_260413/202604130127189073.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.36" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.36" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260413/202604130127189073_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260413/202604130127189073_720.jpg"> </div><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dc03a974b7enative.htm" target="_blank" weibo="" mode="1,2">十拿九稳？意甲积分榜：国米剩6轮9分优势领跑 科莫输球距前四2分</a></p><div class="img_wrap" data-ratio="0.36" data="https://tu.duoduocdn.com/uploads/day_260413/202604130442334292.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.36" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.36" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260413/202604130442334292.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260413/202604130442334292.jpg"> </div><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbe7d090136native.htm" target="_blank" weibo="" mode="1,2">近乎五五开！英超夺冠概率：阿森纳从91%暴跌至56%，曼城升至43%</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_260413/202604130247501890.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260413/202604130247501890_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260413/202604130247501890_720.jpg"> </div><p>英超第32轮，曼城客场3-0轻取切尔西，而阿森纳本轮1-2不敌伯恩茅斯。目前曼城少赛一轮落后阿森纳6分，赛后数据机构Polymarket Sports更新了阿森纳与曼城的夺冠概率。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbcf3e01870native.htm" target="_blank" weibo="" mode="1,2">老哥你火了！看台曼城球迷拿着阿森纳标志水瓶疯狂嘲讽，实力抢镜</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbd9817d6c0native.htm" target="_blank" weibo="" mode="1,2">枪迷慎入！足球梗科普：如噩梦般甩不脱的瓶子，究竟是什么意思？</a></p><p>曼城打进第三球后，转播镜头对准了看台的一名曼城球迷，他拿着印有阿森纳标志的水瓶疯狂嘲讽式庆祝。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbd6e61af25native.htm" target="_blank" weibo="" mode="1,2">太抽象了！谢尔基被换下场时疑似将护腿板塞在球裤边缘漏出一个角</a></p><div class="img_wrap" data-ratio="1.8" data="https://tu.duoduocdn.com/uploads/day_260413/202604130131254458.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260413/202604130131254458_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260413/202604130131254458_720.jpg"> </div><p>谢尔基被换下时，谢尔基疑似是将自己的护腿板取下来塞在了球裤边缘，漏出了上面的一角，而他露出来的部分显然是一个人的面部。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbd212260ebnative.htm" target="_blank" weibo="" mode="1,2">下轮天王山之战！争冠赛程对比：曼城将战维拉 枪手对阵纽卡</a></p><div class="img_wrap" data-ratio="1.44" data="https://tu.duoduocdn.com/uploads/day_260413/202604130128052847_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.44" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.44" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260413/202604130128052847_1280.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260413/202604130128052847_1280.jpg"> </div><p>曼城少赛1场距榜首阿森纳6分，两队还有一场天王山之战下轮打响。两队赛程对比如上图。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbd64fb7c38native.htm" target="_blank" weibo="" mode="1,2">0-3完败曼城！1998年3月以来首次，切尔西遭遇3连败且一球未进</a></p><div class="img_wrap" data-ratio="1.35" data="https://tu.duoduocdn.com/uploads/day_260318/69ba44dcdb6c3.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.35" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.35" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260318/69ba44dcdb6c3.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260318/69ba44dcdb6c3.jpg"> </div><p>1998年3月以来，切尔西首次遭遇3连败且未进一球。在最近的7场比赛中，蓝军仅取得1场胜利，并在5场英超比赛中输掉了4场。此外，他们在最近5个主场比赛中均未能实现零封。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbe358a3382native.htm" target="_blank" weibo="" mode="1,2">下轮天王山！瓜帅：尊重阿森纳，他们是欧洲最佳，赢一次已很难</a></p><div class="img_wrap" data-ratio="1.48" data="https://tu.duoduocdn.com/uploads/day_260117/696b7d4422def.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.48" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.48" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260117/696b7d4422def.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260117/696b7d4422def.jpg"> </div><p>切尔西本轮0-3完败于曼城。赛后，瓜迪奥拉接受天空体育采访。他谈到多个话题，包括下轮到来的天王山之战。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbec4ea7836native.htm" target="_blank" weibo="" mode="1,2">瓜帅：受制于必须赢的压力反倒拿不了冠军 阿森纳依然是欧洲最佳</a></p><div class="img_wrap" data-ratio="1.8" data="https://tu.duoduocdn.com/uploads/day_260413/202604130302467666_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260413/202604130302467666_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260413/202604130302467666_720.jpg"> </div><p>英超第32轮，曼城3-0击败切尔西。赛后，曼城主帅瓜迪奥拉出席了新闻发布会，回答了记者的提问，并谈到比赛中的调整、谢尔基、下轮联赛和阿森纳之间的“天王山之战”等等话题。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-13/69dbf83861d2anative.htm" target="_blank" weibo="" mode="1,2">罗塞尼尔：即便是瓜帅和克洛普也需要一年时间，我一月份才接手</a></p><div class="img_wrap" data-ratio="1.81" data="https://tu.duoduocdn.com/uploads/day_260413/202604130400177708.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="