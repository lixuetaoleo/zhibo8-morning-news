 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/match1945426date2026vnative.htm" target="_blank" weibo="" mode="1,2">友谊赛-法国1-2科特迪瓦 阿玛德建功盖拉·杜埃传射谢尔基破门</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1945426_1780606959_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1945426_1780606959_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1945426_1780606959_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">谢尔基先拔头筹，阿玛德·迪亚洛第84分钟破门，最终法国友谊赛1-2不敌科特迪瓦。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/match1982261date2026vnative.htm" target="_blank" weibo="" mode="1,2">友谊赛-西班牙1-1伊拉克 费兰破门奥尔莫助攻多斯基世界波</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1982261_1780606037_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1982261_1780606037_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1982261_1780606037_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">奥尔莫助攻费兰破门首开纪录，随后多斯基世界波扳平比分，西班牙1-1战平伊拉克。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/match1982298date2026vnative.htm" target="_blank" weibo="" mode="1,2">友谊赛-瑞典2-2希腊 约克雷斯尼尔松破门 马苏拉斯读秒绝平</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1982298_1780599515_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1982298_1780599515_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260605/zhanbao_image_1982298_1780599515_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">约克雷斯任意球折射建功，尼尔松破门帮助瑞典反超，马苏拉斯读秒绝平，最终瑞典2-2希腊。</span></p><p><strong><span style="color: rgb(51, 51, 51);">【其他新闻】</span></strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/6a2196f86b7adnative.htm" target="_blank" weibo="" mode="1,2">红军新帅！官方：43岁伊劳拉出任利物浦新任主帅，接替斯洛特</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/6a21c57c22ec8native.htm" target="_blank" weibo="" mode="1,2">少帅时代！BIG6主帅：伊劳拉43岁最年轻，塔帅&amp;卡里克&amp;阿隆索44岁</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260530/202605302033504255.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260530/202605302033504255.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260530/202605302033504255.jpg"> </div><p><span style="color: rgb(0, 0, 0);">利物浦官方宣布，43岁的西班牙教练伊劳拉出任球队新帅，接替此前离任的斯洛特。据多方媒体表示，双方此次将签下两年短约。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-04/6a219be7709d5native.htm" target="_blank" weibo="" mode="1,2">本菲卡官方：若弗洛伦蒂诺胜选，皇马将支付穆帅1500万解约金</a></p><div class="img_wrap" data-ratio="0.71" data="https://tu.duoduocdn.com/uploads/day_260604/202606042338457295.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.71" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.71" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260604/202606042338457295_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260604/202606042338457295_720.jpg"> </div><p><span style="color: rgb(0, 0, 0);">本菲卡向葡萄牙证券市场通告，确认如果弗洛伦蒂诺胜选皇马主席，就会支付穆里尼奥的解约金。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/6a21e7ee7b999native.htm" target="_blank" weibo="" mode="1,2">弗洛伦蒂诺：已敲定穆帅、科纳特、邓弗里斯 还有银河战舰级报价</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/6a21eb40da7cdnative.htm" target="_blank" weibo="" mode="1,2">是谁？弗洛伦蒂诺：将超1.5亿欧报价一名银河战舰级别中前场超巨</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/6a21ef3e946fdnative.htm" target="_blank" weibo="" mode="1,2">连签三人！弗洛伦蒂诺确认：第三笔引援是邓弗里斯</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-05/6a21fb9d768ccnative.htm" target="_blank" weibo="" mode="1,2">符合老佛爷条件身价过亿球员仅9人：巴黎5人+巴萨3人+穆西亚拉</a></p><div class="img_wrap" data-ratio="1.26" data="https://tu.duoduocdn.com/uploads/day_260605/202606050503147091.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.26" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.26" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260605/202606050503147091_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260605/202606050503147091_720.jpg"> </div><p><span style="color: rgb(0, 0, 0);">皇马主席竞选正在进行中，弗洛伦蒂诺今日出镜当地媒体节目《地平线》，接受独家专访。弗洛伦蒂诺在节目中发言，亲承已经敲定了穆里尼奥、科纳特和邓弗里斯的签约，此外还有一笔“银河战舰级别”的超巨报价将在下周进行。</span></p><p><a href="https://n