 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/match1949150date2026vnative.htm" target="_blank" weibo="" mode="1,2">新帅两连胜！葡萄牙2-1挪威 C罗替补未登场 菲利克斯、拉莫斯建功</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949150_1790541986_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949150_1790541986_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949150_1790541986_gray.jpeg"> </div><p>菲利克斯、贡萨洛·拉莫斯破门，挪威门将尼兰德送礼，哈兰德破门+失良机；C罗替补未登场。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/match1949149date2026vnative.htm" target="_blank" weibo="" mode="1,2">2轮不胜！德国主场0-1希腊 渣氏德国仍无缘首胜希腊2连胜小组领跑</a></p><div class="img_wrap" data-ratio="0.65" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949149_1790542790_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.65" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.65" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949149_1790542790_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949149_1790542790_gray.jpeg"> </div><p><span>渣氏德国首胜仍未到来！阿德耶米、基米希造险，德国全场14射5正难破门。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/match1949148date2026vnative.htm" target="_blank" weibo="" mode="1,2">哈维首胜！荷兰2-1塞尔维亚 梅尔丁克点射+双响 加克波伤退</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949148_1790531613_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949148_1790531613_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260928/zhanbao_image_1949148_1790531613_gray.jpeg"> </div><p>梅尔丁克双响+处子球；加克波遭剪刀脚飞铲伤退，赖因德斯失良机；哈维取执教荷兰首胜。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab98ccfac751native.htm" target="_blank" weibo="" mode="1,2">热苏斯：我和C罗约好最后半小时让他上 但拉莫斯状态太好不该动他</a></p><div class="img_wrap" data-ratio="1.73" data="https://tu.duoduocdn.com/uploads/day_260928/202609280542534949.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.73" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.73" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260928/202609280542534949_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260928/202609280542534949_720.jpg"> </div><p>葡萄牙客场2-1战胜挪威，拿下欧国联两连胜并独自领跑小组。赛后葡萄牙主帅若热·热苏斯解释了为何全程没有将队长C罗换上场的原因。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab99afd10f46native.htm" target="_blank" weibo="" mode="1,2">临时变卦未让C罗登场！热苏斯：足球就是这样，计划赶不上变化</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab99c64b92cbnative.htm" target="_blank" weibo="" mode="1,2">C罗赛后未谢场？热苏斯：确实得和他聊聊这件事 但我了解他的为人</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab98e88ebd34native.htm" target="_blank" weibo="" mode="1,2">球报：C罗终场哨响后直接返回更衣室，其余所有替补都到中圈谢场</a></p><div class="img_wrap" data-ratio="1.81" data="https://tu.duoduocdn.com/uploads/day_260928/202609280552274371.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.81" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.81" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260928/202609280552274371.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260928/202609280552274371.jpg"> </div><p>据《球报》报道，欧国联第二轮挪威1-2不敌葡萄牙的比赛战罢后，C罗在终场哨吹响的瞬间就径直返回了更衣室。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab999383c720native.htm" target="_blank" weibo="" mode="1,2">出球后被B席发力踢倒！厄德高补时气得拍地+怒骂F**k you</a></p><div class="img_wrap" data-ratio="0.92" data="https://tu.duoduocdn.com/uploads/day_260928/202609280632335981.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.92" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.92" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260928/202609280632335981.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260928/202609280632335981.jpg"> </div><p>厄德高在已经出球之后被B席发力踢倒。B席因为这次动作吃到黄牌。比赛继续进行后，厄德高在传球之后直接对着B席连骂了两句F**k you。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab980ed858c8native.htm" target="_blank" weibo="" mode="1,2">黑马相！希腊力压德荷领跑欧国联小组，人才井喷4000万措利斯当家</a></p><div class="img_wrap" data-ratio="1.67" data="https://tu.duoduocdn.com/uploads/day_260928/6ab98273cd529_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.67" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260928/6ab98273cd529_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260928/6ab98273cd529_720.jpg"> </div><p>希腊已经积6分领跑小组，力压荷兰和德国，并且还在与德国的直接对话中胜出。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab942de771c8native.htm" target="_blank" weibo="" mode="1,2">希望没事！加克波遭卢基奇剪刀脚放铲，无法坚持被范博梅尔换下</a></p><p>荷兰vs塞尔维亚第17分钟，加克波被换下，几分钟前他被卢基奇粗野铲翻，他一度尝试坚持比赛但之后还是被鲁本·范博梅尔换下。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab983ce0356bnative.htm" target="_blank" weibo="" mode="1,2">谁是历史最佳？亚马尔：梅西 毫无疑问 看球的都知道 没有其他人</a></p><div class="img_wrap" data-ratio="1.82" data="https://tu.duoduocdn.com/uploads/day_260928/202609280508087500.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.82" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.82" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260928/202609280508087500_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260928/202609280508087500_720.jpg"> </div><p>近日，亚马尔接受了ON Sport频道的采访，并毫不犹豫地表示自己心中的足坛历史最佳球员是梅西。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-28/6ab94d8b6077enative.htm" target="_blank" weibo="" mode="1,2">曼城前主席：罚款对曼城根本不痛不痒，必须降级，我算过要扣80分</a></p><div class="img_wrap" data-ratio="1.39" data="https://tu.duoduocdn.com/uploads/day_260906/202609062321451614_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; he