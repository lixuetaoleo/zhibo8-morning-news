 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a710739d24ffnative.htm" target="_blank" weibo="" mode="1,2">40岁再就业！官方：佛得角门将沃齐尼亚加盟智利甲球队科洛科洛</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_260804/202608040530361954_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260804/202608040530361954_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260804/202608040530361954_720.jpg"> </div><p>官方消息，40岁佛得角门将沃齐尼亚加盟智利甲球队科洛科洛。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70f39b57181native.htm" target="_blank" weibo="" mode="1,2">官方：皇马前锋贡萨洛加盟富勒姆，转会费总价4200万欧+30%二转</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_260804/202608040402418668.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260804/202608040402418668.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260804/202608040402418668.jpg"> </div><p>官方消息，皇马前锋贡萨洛·加西亚加盟富勒姆，双方签约至2031年，外加一年俱乐部续约选项。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70fa9624fbenative.htm" target="_blank" weibo="" mode="1,2">官方：21岁皇马中场帕拉西奥斯加盟富勒姆，转会费1000万+30%二转</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_260804/202608040432134913.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260804/202608040432134913.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260804/202608040432134913.jpg"> </div><p>官方消息，21岁皇马中场塞萨尔·帕拉西奥斯加盟富勒姆，双方签约至2031年，外加一年俱乐部续约选项。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a7114c7328dbnative.htm" target="_blank" weibo="" mode="1,2">ESPN：皇马为维尼修斯开出年薪2200万新合同，但他想要接近3000万</a></p><div class="img_wrap" data-ratio="1.42" data="https://tu.duoduocdn.com/uploads/day_260511/6a00e3031d1e3.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.42" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.42" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260511/6a00e3031d1e3.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260511/6a00e3031d1e3.jpg"> </div><p>据巴西ESPN报道，皇马已向维尼修斯开出一份年薪2200万欧元的新合同。但这份报价与维尼修斯的诉求仍有不小差距，维尼修斯要求更高薪资，他的预期年薪接近3000万欧元。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70bfa8c0dd1native.htm" target="_blank" weibo="" mode="1,2">电讯报：特朗普将尽一切可能保住因凡蒂诺，他对因凡蒂诺颇为赏识</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260720/6a5d63ef9b863_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260720/6a5d63ef9b863.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260720/6a5d63ef9b863.jpg"> </div><p>据《电讯报》最新消息，知情人士称，因凡蒂诺因计划出售世界杯股份正面临被罢免国际足联主席一职的局面，特朗普将 “尽一切可能” 保住他。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70c46e708f3native.htm" target="_blank" weibo="" mode="1,2">英媒：欧亚+中北美足联决心扳倒因凡蒂诺 已筹备“瘫痪FIFA”计划</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260801/6a6ddbb70a8a4_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260801/6a6ddbb70a8a4.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260801/6a6ddbb70a8a4.jpg"> </div><p>泰晤士报消息，一个旨在推翻因凡蒂诺的联盟已经形成，该联盟领导人计划“瘫痪国际足联”。他们甚至准备在他拒绝辞去主席职务时，绕过FIFA，举办自己的国际赛事。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a71070fa5100native.htm" target="_blank" weibo="" mode="1,2">每体：放弃出售世界杯股权，因凡蒂诺仍无缘5500万欧天价年薪</a></p><div class="img_wrap" data-ratio="1.46" data="https://tu.duoduocdn.com/uploads/day_260802/6a6f3853300de_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.46" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.46" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260802/6a6f3853300de.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260802/6a6f3853300de.jpg"> </div><p>每体报道，国际足联主席因凡蒂诺在放弃向私人资本出售世界杯的计划后，将无缘获得一笔惊人的加薪。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a710deb8021bnative.htm" target="_blank" weibo="" mode="1,2">泣血！巴勒斯坦足协声明：十五年来的诉求，FIFA永远双标和拖延</a></p><div class="img_wrap" data-ratio="1.21" data="https://tu.duoduocdn.com/uploads/day_200519/5ec3651b6e94b.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.21" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.21" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_200519/5ec3651b6e94b.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_200519/5ec3651b6e94b.jpg"> </div><p>巴勒斯坦足协官方发布声明，控诉国际足联面对自己超过十五年的诉求，始终双标和无休止的拖延。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70c1fc6a43bnative.htm" target="_blank" weibo="" mode="1,2">被诺伊尔抢走首发！鲍曼：我跟纳帅电话了一小时，他也感到很抱歉</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260520/6a0d86363c7e1.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260520/6a0d86363c7e1.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260520/6a0d86363c7e1.jpg"> </div><p>鲍曼作为德国队在世预赛的主力门将，但在世界杯到来前夕被复出的诺伊尔占据首发位置，鲍曼在霍芬海姆的集训营接受采访时，透露了他与前德国主帅纳格尔斯曼的沟通内容。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70c5bc5bdeenative.htm" target="_blank" weibo="" mode="1,2">意媒：伊布因故大概率将缺席巴雷西的葬礼，老板卡迪纳莱将会出席</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_230605/647d044f2722f.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_230605/647d044f2722f.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_230605/647d044f2722f.jpg"> </div><p>据米兰新闻网报道称，伊布因故大概率将缺席巴雷西的葬礼，老板卡迪纳莱将会出席。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70c69a426ednative.htm" target="_blank" weibo="" mode="1,2">仅卖出2人！每体：巴萨的球员出售工作陷入停滞 这一难题亟待解决</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_240828/66cf3ac0c8136.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_240828/66cf3ac0c8136.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_240828/66cf3ac0c8136.jpg"> </div><p>据西班牙媒体每日体育报报道，巴萨的球员出售工作目前陷入停滞，这一难题亟待解决。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70c4c7d18e1native.htm" target="_blank" weibo="" mode="1,2">格瓦迪奥尔：与葡萄牙比赛的有些画面转播没有呈现，只能接受现实</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260517/6a0976e77fa33.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260517/6a0976e77fa33.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260517/6a0976e77fa33.jpg"> </div><p>近日，曼城中卫格瓦迪奥尔接受了Talking-city的采访，他谈到了世界杯出局、回顾上赛季、瓜帅卸任以及个人爱好等话题。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a70fff0048cenative.htm" target="_blank" weibo="" mode="1,2">B席：皇马给我一种家的感觉 穆里尼奥将葡萄牙的名号推向世界顶峰</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/news/day_260804/202608040459256645.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.78" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.78" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260804/202608040459256645.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260804/202608040459256645.jpg"> </div><p>B席完成了在皇马的首堂训练课，随后接受了皇马电视台采访。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a7104add5b3cnative.htm" target="_blank" weibo="" mode="1,2">74岁范加尔:荷兰足协找不到合适的人于是又提起我 我感觉难以理解</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260803/6a704759e0f9c_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260803/6a704759e0f9c.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260803/6a704759e0f9c.jpg"> </div><p>74岁的范加尔接受采访时表示，永远愿意帮助荷兰足协，不会拒绝执教国家队。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-04/6a710690db2cenative.htm" target="_blank" weibo="" mode="1,2">曼晚：曼联领跑霍尔争夺战，球员不想回切尔西，纽卡想要6000万镑</a></p><div class="img_wrap" data-ratio="1.51" data="https://tu.duoduocdn.com/uploads/day_260804/6a7107a6d245f.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.51" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.51" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260804/6a7107a6d245f.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260804/6a7107a6d245f.jpg"> </div><p>据曼彻斯特晚报报道，曼联在纽卡左后卫刘易斯・霍尔的争夺战中占据领跑位置，霍尔无意回归切尔西。</p><a href="http://m.zhibo8.cc/topic/index.html?id=165" class="hide" style="     background: url('http://tu.duoduocdn.com/uploads/day_200905/zt_4221599266620.png') no-repeat;     background-size: cover;     display: block;     height: 150px;     max-width: 690px;     color: white;     margin: 24px auto;     position: relative;     border-radius: 10px;     overflow: hidden; ">     <div style="     position: absolute;     height: 50px;     line-height: 50px;     font-size: 16px;     left: 0;     bottom: 0;     right: 0;     text-indent: 15px;     background: rgba(0,0,0,0.3);     color:white; ">直播吧足球早报-早看早知道</div>      <div style="     position: absolute;     height: 20px;     line-height: 20px;     font-size: 12px;     right: 10px;     top: 10px;     border-radius: 5px;     width: 40px;     text-align: center; 	background: rgba(0,0,0,0.3);     color:white; ">专题</div> </a><script> 	$(function(){ 	    $(".video-bg").find('span').click(function(){/*视频播放*/             var _this = this;             var index = $(".video-bg span").index(this);             var MediaArr = document.getElementsByTagName("video");             $(this).parent().hide();             MediaArr[index].play();             MediaArr[index].controls = true;             $(".video-box").each(function(i, item) {                 if ($(this).find('span').get(0) !== _this) {                     $(this).find('.video-bg').show();                     MediaArr[i].pause();                     MediaArr[i].controls = false;                 }             })         });  	if(typeof(canLoadImage)=='function'){/*新版图片打开方式定义*/ 		if(!((typeof(getNetType)==='function' && getNetType()) || canLoadImage())){             $(".img_wrap").css('background-color', '#D9D9DA').find('.play_btn').css('text-indent','0');         } 		var platform = $('input[name="platform"]').val(); 		platform = platform=='ios'?'ios':'android'; 		var img_op = img_op_value = ''; 		function show_small_gif1(){ 			$(".img_wrap").each(function(i){ 				img_op = get_img_op_attr($(this),platform); 				img_op_value = get_op(img_op,platform); 				var lineHeight = $(this).find('.play_btn').height();  				if((img_op_value==1||img_op_value==2||img_op_value==3||img_op_value==4||img_op_value==7)&&$(this).attr("data-thumb")!=''){ 				    $(this).css('background-image',"url('"+$(this).attr("data-thumb")+"')"); 				    $(this).find('.play_btn').html('').css('font-size','3em').css('color','white').css('line-height', lineHeight + 'px').css('background', 'url(https://static4style.duoduocdn.com/common/img/ic_gif_big@3x.png) no-repeat center center').css('background-size','104px'); 				} 			}); 		}  		setTimeout(show_small_gif1(),100); 		/*load_type 1=wifi,2=4G&&loadimg,3=4G&&noloadimg*/ 		function load_img(this_obj,load_type,status) { 			img_op = get_img_op_attr(this_obj,platform); 			img_op_value = get_op(img_op,platform); 			/*var img = this_obj.children('img:first');*/ 			var img = this_obj.find('img:eq(0)'); 			if(load_type==1){ 				if(img_op_value==1 || img_op_value==7){ 					if(img.attr('t-rc')==img.attr('src')){ 						open_img(img_op_value,platform,img.attr('t-rc')); 					}else{ 						this_obj.find('.play_btn').hide(); 						img.attr('src', img.attr('t-rc')); 					} 				}else if(status==1){ 					open_img(img_op_value,platform,img.attr('t-rc')); 				} 			}else if(load_type==2&&this_obj.attr('type')=='IMG'){ 				this_obj.find('.play_btn').hide(); 				img.attr('src', img.attr('t-rc')); 			} 			if(typeof(getJSType)=='function' && getJSType()){                 img.load(function(){                     window.webkit.messageHandlers.imageLoaded.postMessage('test');                 }); 			}else if(platform=='ios'&&typeof(imageLoaded)=='function'){ 				img.load(function(){ 				    /*加载完成*/                     imageLoaded(); 				}); 			} 		}; 		 		var ms = 1000; 		if(platform === 'android'){ 		    ms = 10; 		} 		setTimeout(function(){ 			if(typeof(getNetType)=='function' && getNetType()){/*wifi*/ 			$(".img_wrap").each(function(i){ 				load_img($(this),1,0) 				}); 			}else{ 				if(canLoadImage()){/*载入图片*/ 					$(".img_wrap").each(function(i){ 						load_img($(this),2,0) 					}); 			}else{ 				$(".img_wrap").each(function(i){ 					load_img($(this),3,0); 				}); 			} 			} 		}, ms);  		$(".img_wrap").click( 				function(){ 				    var jumpUrl = $(this).attr('jump-url');                     if(jumpUrl){                         return openLink(jumpUrl);                     } 					load_img($(this),1,1); 					event.stopPropagation(); 				} 			); 		$('a').click(function(e){ 			img_op = get_img_op_attr($(this),platform); 			img_op_value = parseInt(get_op(img_op,platform)); 			if(img_op_value>=0&&img_op_value<=7){ 				open_img(img_op_value,platform,$(this).attr('href')); 				if ( e && e.preventDefault ) 					e.preventDefault(); 				else 					window.event.returnValue = false;  				return false; 			}     	}); 	}else{/*旧版本*/ 		function show_small_gif(){ 			$(".img_wrap").each(function(i){ 				/*console.log($(this).css('background-image'));*/ 				$(this).find('.play_btn').css("text-indent","0"); 				if($(this).attr("data-ratio") && /gif/i.test($(this).attr("type")) ){                     var ratio = $(this).attr("data-ratio");                     $(this).css({width:"100%",height:0,"padding-top":100/ratio+"%"}).find(".play_btn").css({top:0,height:'100%'});                 } 				if($(this).attr("data-thumb")!=''){                     $(this).append('<img class="img-thumb" style="position: absolute;top: 0;left: 0;width: 100%;height: 100%;object-fit: cover;" src="'+ $(this).attr("data-thumb") +'" />'); 					$(this).find('.play_btn').html('').css('font-size','3em').css('color','white').css('background', 'url(https://static4style.duoduocdn.com/common/img/ic_gif_big@3x.png) no-repeat center center').css('background-size','104px'); 				} 			}); 		}; 		show_small_gif(); 		$(".img_wrap").click(function (event) { 		    var jumpUrl = $(this).attr('jump-url'); 			if(jumpUrl){ 				return openLink(jumpUrl); 			} 			if ($(this).attr('type') == 'IMG') {                 $(this).css("width", 'auto');                 $(this).css("height", 'auto');                 $(this).css("background", 'none');                 $(this).removeClass("img_wrap");                 $(this).find('.play_btn').hide();                 var img = $(this).find('img:eq(0)');                 img.attr('src', img.attr('t-rc'));                 img.attr('data-src', img.attr('t-rc'));                 event.stopPropagation();             }else{                 $(this).find('.play_btn').hide();                 var img = $(this).find('img:eq(0)');                 img.attr('src', img.attr('t-rc')).on("load",function(){                     $(this).css({width:"auto",height:"auto","padding-top":0,background:"none"});                     $(this).find('.img-thumb').remove();                 }.bind(this));                 img.attr('data-src', img.attr('t-rc'));             } 		});  	    if(typeof(getNetType)=='function' && getNetType()){             /*$(".img_wrap").click();*/             setTimeout('$(".img_wrap").click()',200); 		}else{/*旧版非gif图片3G直接载入图片*/             $(".img_wrap").each(function(i){                 if($(this).attr('type')=='IMG'){                     var img = $(this).find('img:eq(0)');                     var ratio = $(this).attr("data-ratio");                     if(ratio){                         $(this).css({                             width:'100%',                             height:0,                            'padding-top':100/ratio+'%'                         }).find(".play_btn").css({                             top:0,                             height:'100%'                         });                         img.attr('src', img.attr('t-rc')).on("load",function(){                           $(this).css({'padding-top':'0'}).find(".play_btn").hide();                         }.bind(this));                     }else{                       $(this).css("width", 'auto');                       $(this).css("height", 'auto');                       $(this).css("background", 'none');                       $(this).removeClass("img_wrap");                       $(this).find('.play_btn').hide();                       img.attr('src', img.attr('t-rc'));                    }                 }             }); 		} 	}  	function get_op(img_op,platform){ 		img_op_arr = img_op.split('|'); 		if(img_op_arr.length!=4)return 5; 		switch (platform){             case 'android' :                 value = img_op_arr[0].split('_');                 break;             case 'ios' :                 value = img_op_arr[1].split('_');                 break;             case 'wap' :                 value = img_op_arr[2].split('_');                 break;             case 'pc' :                 value = img_op_arr[3].split('_');                 break;             default :                 value = [5,''];         }         return value[0]; 	}  	function get_img_op_attr(img_ele,platform){ 		if(platform=='android'){ 			if(window.zhibo8OpenImage && window.zhibo8OpenImage.openInnerExplorerBrowser){ 				op_value = img_ele.attr('img_op_new'); 			}else{ 				op_value = img_ele.attr('img_op'); 			} 		}else if(typeof(getJSType)=='function' && getJSType()){ 			if(window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.openInnerExplorerBrowser){ 				op_value = img_ele.attr('img_op_new'); 			}else{ 				op_value = img_ele.attr('img_op'); 			} 		}else{ 			op_value = img_ele.attr('img_op'); 		} 		return op_value; 	} 	 	function openLink(aHref) {         if(!aHref) return;         var aNode = document.createElement('a');         aNode.href = aHref;         aNode.click();     }  	function open_img(img_op_value,platform,src){ /*		if(!(img_op_value==1||img_op_value==2||img_op_value==3||img_op_value==4)){ 			return false; 		}*/ 		/*if(src=''||src==undefine)return;*/ 		if(img_op_value==1){ 			if(platform=='android'){ 				window.zhibo8OpenImage.openNativeImageBrowser(src); 			}else if(typeof(getJSType)=='function' && getJSType()){ 				window.webkit.messageHandlers.openNativeImageBrowser.postMessage(src); 			}else{ 				openNativeImageBrowser(src); 			} 		}else if(img_op_value==2){ 			if(platform=='android'){ 				window.zhibo8OpenImage.openImageLinkWebBrowser(src); 			}else if(typeof(getJSType)=='function' && getJSType()){ 				window.webkit.messageHandlers.openImageLinkWebBrowser.postMessage(src); 			}else{ 				openImageLinkWebBrowser(src); 			} 		}else if(img_op_value==3){ 			if(platform=='android'){ 				window.zhibo8OpenImage.openWebViewImageBrowser(src); 			}else if(typeof(getJSType)=='function' && getJSType()){ 				window.webkit.messageHandlers.openWebViewImageBrowser.postMessage(src); 			}else{ 				openWebViewImageBrowser(src); 			} 		}else if(img_op_value==4){ 			if(platform=='android'){ 				window.zhibo8OpenImage.openSystemWebViewBrowser(src); 			}else if(typeof(getJSType)=='function' && getJSType()){ 				window.webkit.messageHandlers.openSystemWebViewBrowser.postMessage(src); 			}else{ 				openSystemWebViewBrowser(src); 			} 		}else if(img_op_value==7){ 			if(platform=='android'){ 				window.zhibo8OpenImage.openInnerExplorerBrowser(src); 			}else if(typeof(getJSType)=='function' && getJSType()){ 				window.webkit.messageHandlers.openInnerExplorerBrowser.postMessage(src); 			}else{ 				openSystemWebViewBrowser(src); 			} 		} 	} 	}) </script><style>.video-box{position:relative;}.video-bg{position: absolute;z-index: 8 !important;width: 100%;height: 100%;background-color: transparent;}.video-bg span{position: absolute;left: 50%;top:50%;margin-left: -2.94em;margin-top:  -2.94em;width: 5.88em;height: 5.88em;background: url(https://static4style.duoduocdn.com/m_images/inside/outs/ic_play@2x.png) center/46px no-repeat;}.video-bg span{position: absolute;width: 100px;height: 100px;left: 50%;top:50%;margin-left: -50px;margin-top:  -50px;}</style>
