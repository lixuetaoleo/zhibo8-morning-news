 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【巴西公布世界杯名单】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/6a0b45abc6c5cnative.htm" target="_blank" weibo="" mode="1,2">巴西世界杯26人名单：内马尔在列！维尼修斯拉菲领衔，佩德罗无缘</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260519/6a0b47e3a341c.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260519/6a0b47e3a341c.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260519/6a0b47e3a341c.jpg"> </div><p>巴西队官方公布了参加本届美加墨世界杯的26人最终名单。34岁内马尔在列！维尼修斯、拉菲尼亚领衔，卡塞米罗、库尼亚、恩德里克入选；若昂·佩德罗、41岁蒂亚戈·席尔瓦无缘；米利唐、埃斯特旺伤缺。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/6a0b2b178fae7native.htm" target="_blank" weibo="" mode="1,2">出征美加墨！内马尔将参加生涯第4届世界杯 此前最好成绩14年4强</a></p><div class="img_wrap" data-ratio="1.74" data="https://tu.duoduocdn.com/uploads/day_260519/202605190510586171.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.74" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.74" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260519/202605190510586171_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260519/202605190510586171_720.jpg"> </div><p>巴西队公布了参加本届美加墨世界杯的26人名单，34岁的内马尔依旧随巴西队出征世界杯。</p><p><strong>【多家媒体称瓜帅赛季末离队】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/6a0b63a7bc366native.htm" target="_blank" weibo="" mode="1,2">结束10年蓝月生涯！邮报：瓜迪奥拉赛季末将离队，英超末轮后官宣</a></p><div class="img_wrap" data-ratio="1.52" data="https://tu.duoduocdn.com/uploads/day_260420/69e51a4dad703.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.52" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.52" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260420/69e51a4dad703.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260420/69e51a4dad703.jpg"> </div><p>据邮报独家消息，瓜迪奥拉将在本赛季英超收官战对阵阿斯顿维拉的赛事结束后，正式卸任曼城主教练一职。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/6a0b74357b62cnative.htm" target="_blank" weibo="" mode="1,2">DO＆罗马诺：瓜迪奥拉赛季末离任，预计他的继任者将是马雷斯卡</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260413/69dc2279dd2cc.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260413/69dc2279dd2cc.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260413/69dc2279dd2cc.jpg"> </div><p>TA王牌记者奥恩斯坦（DO）消息，瓜迪奥拉赛季末离任曼城主帅，他的继任者将是马雷斯卡。随后罗马诺也跟进确认了此消息。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/6a0b758e6cbbbnative.htm" target="_blank" weibo="" mode="1,2">BBC：曼城内部已经开始着手准备瓜帅离任事宜，球队成员都有预料</a></p><div class="img_wrap" data-ratio="1.48" data="https://tu.duoduocdn.com/uploads/day_260117/696b7d4422def.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.48" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.48" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260117/696b7d4422def.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260117/696b7d4422def.jpg"> </div><p>今日凌晨多家媒体消息，曼城主帅瓜迪奥拉将在赛季末离任。</p><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/match1713747date2026vnative.htm" target="_blank" weibo="" mode="1,2">先赛5分领跑！阿森纳1-0伯恩利 哈弗茨制胜+蹬踏染黄 萨卡献助攻</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260519/zhanbao_image_1713747_1779136815_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260519/zhanbao_image_1713747_1779136815_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260519/zhanbao_image_1713747_1779136815_gray.jpeg"> </div><p>阿森纳本轮先赛5分领跑，末轮将战水晶宫！哈弗茨头球制胜，萨卡献角球助攻，哈弗茨蹬踏染黄。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/6a0b3f9a310c0native.htm" target="_blank" weibo="" mode="1,2">英超积分榜：阿森纳先赛还剩1轮5分领跑！曼城明晨客战伯恩茅斯</a></p><div class="img_wrap" data-ratio="0.36" data="https://tu.duoduocdn.com/uploads/day_260519/202605190458352376.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.36" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.36" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260519/202605190458352376_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260519/202605190458352376_720.jpg"> </div><p><strong>【热门新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-19/6a0b8396865d2native.htm" target="_blank" weibo="" mode="1,2">内马尔入选巴西名单！安帅：内马尔会成为我们世界杯上的重要球员</a></p><div class="img_wrap" data-ratio="1.15" data="https://tu.duoduocdn.com/uploads/day_260519/202605190525462648.jpg" data-thumb="" img_op="1_x|1_x|