 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-06/6a7493a8795a6native.htm" target="_blank" weibo="" mode="1,2">重磅引援！官方：皇马签下19岁边锋迪奥曼德，转会费总价1.4亿</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260806/202608062235465975.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260806/202608062235465975.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260806/202608062235465975.jpg"> </div><p>皇马官方宣布，球队签下19岁莱比锡边锋扬·迪奥曼德，双方签约7年！</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74cbfb8c86fnative.htm" target="_blank" weibo="" mode="1,2">他留下！官方：皇马与26岁维尼修斯完成续约，新合同至2032年</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260807/202608070209523289.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260807/202608070209523289_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260807/202608070209523289_720.jpg"> </div><p>皇马官方宣布，与巴西边锋维尼修斯完成续约，新合同至2032年。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74ce34315b3native.htm" target="_blank" weibo="" mode="1,2">与皇马续签长约！维尼修斯：在伯纳乌8年太短了，再来6年直到永远</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260807/202608070212489207.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260807/202608070212489207.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260807/202608070212489207.jpg"> </div><p>皇马官方宣布，与维尼修斯续签一份新的长期合约。维尼修斯在个人社媒转发了皇马与他联合发布的公告。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74c6b83cfcanative.htm" target="_blank" weibo="" mode="1,2">阿斯：维尼修斯新合同年薪2400万欧，枪手的出现加速续约谈判进展</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260706/6a4b5b4733c38.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260706/6a4b5b4733c38.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260706/6a4b5b4733c38.jpg"> </div><p>据DO、罗马诺等记者先后确认，维尼修斯与皇马之间就续约已经达成协议。《阿斯报》报道了此事的更多细节，并表示维尼修斯续约后将获得2400万欧元的年薪。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74bd6ce49ecnative.htm" target="_blank" weibo="" mode="1,2">转会费5000万欧！官方：巴黎从摩纳哥签下24岁法国边锋阿克利乌什</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260807/202608070103556907.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260807/202608070103556907_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260807/202608070103556907_720.jpg"> </div><p>官方消息，巴黎从摩纳哥签下24岁的法国国脚阿克利乌什，球员将身披11号球衣，双方签约至2031年；据悉转会费为5000万欧。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74c9d81ed43native.htm" target="_blank" weibo="" mode="1,2">创队史纪录！官方：利兹联签下曼城门将特拉福德，总价4500万镑</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_260807/202608070201154736.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260807/202608070201154736_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260807/202608070201154736_720.jpg"> </div><p>官方消息，曼城门将特拉福德转会利兹联。据罗马诺报道，转会费总价4500万镑，曼城将获得该球员未来任何转会利润的20%分成，并保留报价匹配权。这笔签约创造了利兹联队史纪录。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74f9e09ce27native.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺：切尔西总价2100万欧签巴列卡诺28岁左后卫查瓦里亚</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260807/202608070517467539_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260807/202608070517467539_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260807/202608070517467539_720.jpg"> </div><p>名记罗马诺以标志性的“Here We Go”确认，切尔西将签下巴列卡诺左后卫查瓦里亚，转会费总价2100万欧。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a750c9fc06eenative.htm" target="_blank" weibo="" mode="1,2">罗马诺：巴萨与罗德里就个人条款达协议，将与曼城谈判确定转会费</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260707/6a4c6c23b3cad_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260707/6a4c6c23b3cad.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260707/6a4c6c23b3cad.jpg"> </div><p><span>据罗马诺消息，巴萨已向罗德里的经纪人提交合同报价，双方就个人条款完全达成一致。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-06/6a74a146b227dnative.htm" target="_blank" weibo="" mode="1,2">马卡：巴萨获得罗德里的加盟答复，皇马已经获悉球员将会加盟巴萨</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260715/6a56add739bd2_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260715/6a56add739bd2.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260715/6a56add739bd2.jpg"> </div><p>据《马卡报》报道称，巴萨已经获得罗德里的加盟答复，这笔交易金额不会低于5000万欧。皇马已经获悉罗德里最终会加盟巴萨，对签下他持悲观态度。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74ae8896d56native.htm" target="_blank" weibo="" mode="1,2">阿斯：巴萨签罗德里费用约6000万欧元，提供4年税前3000万欧合同</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260720/6a5d54cb715f9_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260720/6a5d54cb715f9.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260720/6a5d54cb715f9.jpg"> </div><p>今日多家媒体报道，巴萨加入对罗德里的竞争，罗德里同意与巴萨进行谈判。据《阿斯报》的最新报道，巴萨为罗德里开出了为期4年，年薪税前3000万欧元的合同。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-06/6a74adda780f9native.htm" target="_blank" weibo="" mode="1,2">罗马诺谈皇马官宣迪奥曼德：干这行15年，我不会随便冒风险乱爆料</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/news/day_260727/202607271002378106.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260727/202607271002378106.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260727/202607271002378106.jpg"> </div><p>知名转会专家罗马诺更新Youtube频道，他再度谈及迪奥曼德的转会。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-07/6a74b8708f170native.htm" target="_blank" weibo="" mode="1,2">TA：皇马内部达成共识需补强右路，穆帅用流利法语招募了迪奥曼德</a></p><div class="img_wrap" data-ratio="1.49" data="https://tu.duoduocdn.com/uploads/day_251207/6934ba598f6f3_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_