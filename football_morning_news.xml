 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/match1930286date2026vnative.htm" target="_blank" weibo="" mode="1,2">残阵克强敌！皇马3-0曼城占先机 巴尔韦德戴帽库尔图瓦助攻+神扑</a></p><div class="img_wrap" data-ratio="0.69" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930286_1773264998_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.69" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.69" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930286_1773264998_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930286_1773264998_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">巴尔韦德戴帽，皇马3-0曼城占得先机，双方次回合将于18日移师曼城主场。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/match1930291date2026vnative.htm" target="_blank" weibo="" mode="1,2">哈弗茨绝平旧主！阿森纳1-1客平药厂欧冠8连胜终结 马杜埃凯造点</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930291_1773257988_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930291_1773257988_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930291_1773257988_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">阿森纳客场1-1绝平勒沃库森，枪手本赛季欧冠8连胜遭终结，双方将于3月18日移师酋长球场进行次回合较量。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/match1930284date2026vnative.htm" target="_blank" weibo="" mode="1,2">进球大战！巴黎5-2切尔西占先机 K77双响登贝莱建功约恩森送礼</a></p><div class="img_wrap" data-ratio="0.66" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930284_1773266252_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.66" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.66" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930284_1773266252_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930284_1773266252_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">巴黎5-2击败切尔西，双方次回合比赛将于北京时间3月18日凌晨4时移师斯坦福桥球场进行。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/match1930290date2026vnative.htm" target="_blank" weibo="" mode="1,2">欧冠5连胜！博德闪耀3-0葡体占先机 海于格造2球 菲特、霍格建功</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930290_1773264974_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930290_1773264974_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260312/zhanbao_image_1930290_1773264974_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">博德闪耀主场3-0完胜葡萄牙体育，欧冠豪取5连胜！次回合将在葡体主场进行。</span></p><p><strong><span style="color: rgb(51, 51, 51);">【赛后声音】</span></strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/69b1ebb1e62fanative.htm" target="_blank" weibo="" mode="1,2">阿韦洛亚：巴尔韦德是21世纪华尼托 晋级？我告诉球员们还没结束</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260118/696cd0ae652f5.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260118/696cd0ae652f5.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260118/696cd0ae652f5.jpg"> </div><p><span style="color: rgb(0, 0, 0);">皇马本场欧冠3-0完胜曼城，在两回合对阵中占得先机。赛后，阿韦洛亚接受采访。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/69b1ecb0578e0native.htm" target="_blank" weibo="" mode="1,2">库尔图瓦谈对奥赖利神扑：那一下纯粹是靠本能反应，没法说更多了</a></p><p><span style="color: rgb(0, 0, 0);">欧冠1/8决赛首回合，皇马3-0大胜曼城，库尔图瓦接受了混合区的采访，谈到自己对奥赖利的神扑。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/69b1ed26aea4dnative.htm" target="_blank" weibo="" mode="1,2">瓜迪奥拉：我们缺少关键的最后一传，比赛过程并不像比分这么糟糕</a></p><div class="img_wrap" data-ratio="1.38" data="https://tu.duoduocdn.com/uploads/day_251221/69477273aff0d.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.38" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.38" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_251221/69477273aff0d.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_251221/69477273aff0d.jpg"> </div><p><span style="color: rgb(0, 0, 0);">在今天凌晨进行的欧冠1/8决赛首回合，曼城客场0-3负于皇马。赛后曼城主帅瓜迪奥拉接受了Movistar的采访。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/69b1eefde40ffnative.htm" target="_blank" weibo="" mode="1,2">皮塔奇：对我来说这场比赛简直像一场梦，我会永远感激阿韦洛亚</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260302/69a597e4d38cc.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260302/69a597e4d38cc.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260302/69a597e4d38cc.jpg"> </div><p><span style="color: rgb(0, 0, 0);">欧冠1/8决赛首回合，皇马3-0大胜曼城，小将皮塔奇赛后接受了Movistar的采访。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/69b1f13b70715native.htm" target="_blank" weibo="" mode="1,2">内托为推球童道歉：我立刻道歉并将球衣送他，大概说了35次对不起</a></p><div class="img_wrap" data-ratio="1.53" data="https://tu.duoduocdn.com/uploads/day_241111/673160f7494f5.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.53" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.53" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_241111/673160f7494f5.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_241111/673160f7494f5.jpg"> </div><p><span style="color: rgb(0, 0, 0);">欧冠1/8决赛首回合，巴黎5-2大胜切尔西，切尔西前锋内托在接受TNT的采访时，就推搡球童道歉。</span></p><p><strong>【其他新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-03-12/69b1d4a69c09enative.htm" target="_blank" weibo="" mode="1,2">集体滑铁卢！英超6队欧冠联赛阶段全体强势突围 本回合却全部没赢</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduo