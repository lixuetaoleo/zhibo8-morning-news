 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-19/match2067688date2026vnative.htm" target="_blank" weibo="" mode="1,2">赛季首败！阿森纳0-3完败布莱顿 拉亚两遭远射破门 哈弗茨失单刀</a></p><div class="img_wrap" data-ratio="0.67" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260919/zhanbao_image_2067688_1789832069_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.67" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260919/zhanbao_image_2067688_1789832069_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260919/zhanbao_image_2067688_1789832069_gray.jpeg"> </div><p>阿森纳赛季首败&amp;7连胜遭终结；布莱顿2轮8球2连胜，哈弗茨单刀不进。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/match2075470date2026vnative.htm" target="_blank" weibo="" mode="1,2">7连胜领跑！巴萨3-1逆转塞维利亚 拉菲尼亚连场戴帽亚马尔两助攻</a></p><div class="img_wrap" data-ratio="0.61" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2075470_1789851514_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.61" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.61" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2075470_1789851514_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2075470_1789851514_gray.jpeg"> </div><p>拉菲尼亚连场戴帽！亚马尔助攻双响，克里斯滕森助攻+伤退，戈登连失良机。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/match2057425date2026vnative.htm" target="_blank" weibo="" mode="1,2">榜首战握手言和！国米2-2罗马 科内劳塔罗双响两队开局四连胜终结</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2057425_1789840934_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2057425_1789840934_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2057425_1789840934_gray.jpeg"> </div><p>国米上演让二追二，科内双响，劳塔罗梅开二度追平；罗马国米均连胜终结，仍居联赛前二。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/match2076781date2026vnative.htm" target="_blank" weibo="" mode="1,2">升榜首！多特1-0击败斯图加特取4连胜 小贝林厄姆助攻拜尔制胜</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2076781_1789841659_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2076781_1789841659_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2076781_1789841659_gray.jpeg"> </div><p>拜尔制胜，小贝林厄姆替补登场送助攻，多特蒙德4连胜继续领跑积分榜。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-19/match2067695date2026vnative.htm" target="_blank" weibo="" mode="1,2">5轮不胜！热刺2-3送维拉首胜 热刺联赛首球曼赞比传射杰克逊建功</a></p><div class="img_wrap" data-ratio="0.61" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260919/zhanbao_image_2067695_1789825561_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.61" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.61" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260919/zhanbao_image_2067695_1789825561_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260919/zhanbao_image_2067695_1789825561_gray.jpeg"> </div><p>加拉格尔打进热刺英超赛季首球，曼赞比传射，布恩迪亚世界波破门，热刺英超5轮不胜，维拉获联赛首胜。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/match2067694date2026vnative.htm" target="_blank" weibo="" mode="1,2">联赛首胜+首球！考文垂1-0诺丁汉森林 达席尔瓦制胜球门将助攻</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2067694_1789841850_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2067694_1789841850_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260920/zhanbao_image_2067694_1789841850_gray.jpeg"> </div><p>达席尔瓦破门，考文垂门将拉什沃斯送助攻，伊戈尔·热苏斯进球被吹。考文垂打进时隔25年的联赛首球，取得时隔25年后的联赛首胜。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/6aaeda565f4cdnative.htm" target="_blank" weibo="" mode="1,2">两度上演奔袭！萨拉赫土超戴帽，特拉布宗打爆榜首加拉塔萨雷</a></p><div class="img_wrap" data-ratio="1.24" data="https://tu.duoduocdn.com/uploads/day_260920/6aaedb0c51fe9_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.24" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.24" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260920/6aaedb0c51fe9.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260920/6aaedb0c51fe9.jpg"> </div><p>土超第6轮，特拉布宗对阵榜首球队加拉塔萨雷，萨拉赫在第4分钟、第44分钟和第80分钟进球，完成帽子戏法，并且两次上演奔袭破门！本场比赛最终特拉布宗4-0大胜。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-19/6aaea90890117native.htm" target="_blank" weibo="" mode="1,2">海鸥咬人了！布莱顿周中让二追三逆转曼联 今日主场3球完胜枪手</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260919/6aaead4b077ae_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260919/6aaead4b077ae_1280.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260919/6aaead4b077ae_1280.jpg"> </div><p>在周中的联赛杯比赛中，布莱顿在0-2落后的情况下，在老特拉福德连进3球，让2追3逆转曼联。在本周的联赛中，布莱顿主场3-0大胜枪手，终结阿森纳各项赛事7连胜！</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/6aaeba656b9b8native.htm" target="_blank" weibo="" mode="1,2">惨负海鸥！阿尔特塔：这是很大的教训 像这样浪费机会比赛没法踢</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260910/6aa1ccf7eb5f7_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260910/6aa1ccf7eb5f7.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260910/6aa1ccf7eb5f7.jpg"> </div><p>本轮英超，卫冕冠军阿森纳0-3惨败于布莱顿。赛后，阿森纳主帅阿尔特塔接受BBC radio 5采访。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/6aaec37fb0f3enative.htm" target="_blank" weibo="" mode="1,2">赖斯报复性动作染黄！英媒：VAR认定不是暴力行为，只是莽撞举动</a></p><p>阿森纳vs布莱顿最后时刻，亚尔库耶故意冲撞赖斯，随后赖斯报复性放倒前者，吃到黄牌。据talkSPORT获悉，英超官方随后就未将其罚下的决定作出了解释。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/6aaef871aefd4native.htm" target="_blank" weibo="" mode="1,2">超神状态！拉菲尼亚连场戴帽，新赛季8场14球3助、仅1场没进球</a></p><div class="img_wrap" data-ratio="1.54" data="https://tu.duoduocdn.com/uploads/day_260920/202609200503084107_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.54" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.54" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260920/202609200503084107_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260920/202609200503084107_720.jpg"> </div><p><span style=" 0, 0);">新赛季以来，拉菲尼亚各赛事8场打进14球助攻3次，其中联赛12球领跑射手榜，仅对莱万特没进球。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-20/6aaeb12312086native.htm" target="_blank" weibo="" mode="1,2">TA：伯利曾想为切尔西签下C罗，但时任主帅图赫尔强烈反对</a></p><div