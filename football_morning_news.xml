 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/match2067703date2026vnative.htm" target="_blank" weibo="" mode="1,2">6连胜！曼城3-0送十人利物浦首败 哈兰德谢尔基破门多库替补造2球</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2067703_1791738569_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2067703_1791738569_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2067703_1791738569_gray.jpeg"> </div><p>曼城6轮全胜领跑，红军赛季首败！哈兰德、谢尔基破门，多库替补建功，赫拉芬贝赫两黄变一红。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/match2057443date2026vnative.htm" target="_blank" weibo="" mode="1,2">仍不败！AC米兰1-1萨索洛 拉比奥爆射破门 拉莫斯屡遭神扑</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2057443_1791740633_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2057443_1791740633_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2057443_1791740633_gray.jpeg"> </div><p>拉比奥破门，莫德里奇替补送助攻；米兰开季联赛3胜3平，仍居第5距榜首国米4分。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/match2057442date2026vnative.htm" target="_blank" weibo="" mode="1,2">联赛近4轮1胜！尤文1-1卡利亚里 穆阿尼建功+屡失良机丹马破门</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2057442_1791750493_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2057442_1791750493_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261012/zhanbao_image_2057442_1791750493_gray.jpeg"> </div><p>丹尼尔·马尔蒂尼破门，穆阿尼建功+屡失良机；尤文近4轮1胜2平1负，暂居第6；卡利亚里3连胜遭终结。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbc6e62fea0native.htm" target="_blank" weibo="" mode="1,2">难他天？马雷斯卡接手曼城各赛事8连胜+联赛领跑，至今只输社区盾</a></p><div class="img_wrap" data-ratio="1.8" data="https://tu.duoduocdn.com/uploads/day_261012/202610120127357729.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261012/202610120127357729.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261012/202610120127357729.jpg"> </div><p>曼城主帅马雷斯卡今夏接替瓜迪奥拉，接手曼城，目前曼城仅在赛季第一场比赛（社区盾决赛）中不敌阿森纳，此后的8场比赛（6轮联赛、1场欧冠、1场联赛杯）全部获胜，至今已经是8连胜。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbd20ab528fnative.htm" target="_blank" weibo="" mode="1,2">马雷斯卡在英超执教新球队开局6连胜!此前仅安帅、瓜帅、索帅做到</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/news/day_261012/202610120216043259.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_261012/202610120216043259.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_261012/202610120216043259.jpg"> </div><p>数据统计显示，马雷斯卡是英超历史第4位执教新俱乐部取得开局6连胜的教练，此前3人分别是：安切洛蒂、瓜迪奥拉、索尔斯克亚。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbc486b9365native.htm" target="_blank" weibo="" mode="1,2">高歌猛进！五大联赛仅2队联赛全胜：曼城6轮全胜，巴萨8轮全胜</a></p><div class="img_wrap" data-ratio="1.53" data="https://tu.duoduocdn.com/uploads/day_261010/202610100918212994.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.53" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.53" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261010/202610100918212994_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261010/202610100918212994_720.jpg"> </div><p>曼城3-0客胜利物浦，新赛季联赛保持全胜。新赛季五大联赛还有两队保持全胜，曼城英超6轮全胜，巴萨西甲8轮全胜。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbd930e53d9native.htm" target="_blank" weibo="" mode="1,2">新一代“特工”！巴尔科拉今夏1.45亿加盟利物浦，赛季10场0球0助</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_261012/202610120251097178_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261012/202610120251097178_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261012/202610120251097178_720.jpg"> </div><p>英超第6轮，利物浦主场0-3不敌曼城。今夏以总价1.45亿欧加盟利物浦的巴尔科拉再次未能收获进球和助攻，本赛季俱乐部及国家队各项赛事数据已来到10场0球0助。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbc0f27877bnative.htm" target="_blank" weibo="" mode="1,2">摩根：曼城被曝是史上头号作弊队还庆祝，再让他们夺冠英超就毁了</a></p><div class="img_wrap" data-ratio="2.11" data="https://tu.duoduocdn.com/uploads/day_261012/202610120105283073.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="2.11" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="2.11" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261012/202610120105283073.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261012/202610120105283073.jpg"> </div><p>英超第6轮，利物浦0-3不敌曼城。摩根在社媒发文对曼城进行批评。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbc920bd6ednative.htm" target="_blank" weibo="" mode="1,2">维尼修斯官宣分手！女方团队：没有吵架，只是达成共识不再在一起</a></p><div class="img_wrap" data-ratio="1.6" data="https://tu.duoduocdn.com/uploads/day_261012/202610120148524912.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.6" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.6" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261012/202610120148524912_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261012/202610120148524912_720.jpg"> </div><p>据巴西媒体g1报道，网红弗吉尼亚的新闻公关团队于周日（11日）证实，女方与维尼修斯已经分手。两人分手“没有冲突也没有争吵”，只是达成了“不再以情侣身份走下去”的共识。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbb87e77144native.htm" target="_blank" weibo="" mode="1,2">西媒：皇马认为维尼修斯不是故意拽对手头发，为裁判双标感到愤怒</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_261011/202610110608258232.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261011/202610110608258232_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261011/202610110608258232_720.jpg"> </div><p>据西媒okdiario报道，皇马内部预判，维尼修斯因对阵比利亚雷亚尔时的拽人动作与赛后抗议，将面临三场禁赛，基本无缘与巴萨的国家德比，俱乐部同时对当值裁判组的执法尺度与态度表达强烈不满。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbeaadb1d2cnative.htm" target="_blank" weibo="" mode="1,2">维尼修斯染红后，专家解读库库唇语：碰我一根头发，你也得给红牌</a></p><div class="img_wrap" data-ratio="1" data="http://tu.duoduocdn.com/uploads/day_261012/202610120756576975.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_261012/202610120756576975.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_261012/202610120756576975.jpg"> </div><p>据唇语专家解读，库库雷利亚在维尼修斯染红后找到第四官员喊话施压：“我希望对手要是碰了我的一根头发，你也会掏红牌，你会去看VAR的！”</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbbe9c1c5dfnative.htm" target="_blank" weibo="" mode="1,2">希勒：我见过的球星里梅西就是历史最佳，球技高超性格还极其低调</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_261007/6ac65c840db7f_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261007/6ac65c840db7f.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261007/6ac65c840db7f.jpg"> </div><p>近日，英格兰传奇前锋阿兰·希勒在其专栏中撰文表示，梅西是他职业生涯所见过实力最为出众的球员。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbd38c2b7cdnative.htm" target="_blank" weibo="" mode="1,2">希勒：C罗本该拥有梅西那样的体面告别 职业足球无法承诺你能出场</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-12/6acbb29ea81fenative.htm" target="_blank" weibo="" mode="1,2">阿斯：皇马已报价16岁JJ·加布里埃尔，并做完了所有引援工作</a></p><div class="img_wrap" data-ratio="1.4" data="https://tu.duoduocdn.com/uploads/day_260915/6aa94ab2b3786_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.4" style="width: 100%; height: 200px; background: #eeeeee