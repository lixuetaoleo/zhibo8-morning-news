 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-05/match1942631date2026vnative.htm" target="_blank" weibo="" mode="1,2">爆冷！阿森纳1-2圣徒止步足总杯八强 约克雷斯破门难救主加布伤退</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1942631_1775335524_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1942631_1775335524_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1942631_1775335524_gray.jpeg"> </div><p>爆冷！阿森纳爆冷不敌英冠队，本·怀特冒顶致丢球，加布伤退，阿森纳近2场连续告别联赛杯、足总杯。</p><p><a href="https://x.com/pedritonumeros/status/2040538552178528421" target="_blank" weibo="" mode="1,2">爆冷！皇马1-2遭马略卡绝杀 皇马各赛事5连胜终结、落后榜首7分</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1730628_1775319472_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1730628_1775319472_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1730628_1775319472_gray.jpeg"> </div><p>皇马第88分钟扳平+第91分钟被绝杀；皇马各赛事五连胜终结，周中欧冠将战拜仁。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-05/match1730625date2026vnative.htm" target="_blank" weibo="" mode="1,2">莱万绝杀！巴萨2-1逆转十人马竞 冈萨雷斯1黄1直红马丁直红改黄牌</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1730625_1775336098_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1730625_1775336098_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1730625_1775336098_gray.jpeg"> </div><p>莱万绝杀！巴萨7分优势领跑西甲，4天后双方欧冠再交手；朱利亚诺、拉什福德破门，VAR介入改判冈萨雷斯直红、取消马丁直红。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-04/match1942633date2026vnative.htm" target="_blank" weibo="" mode="1,2">赛季三杀！曼城4-0利物浦进四强 哈兰德戴帽萨拉赫失点+失单刀</a></p><div class="img_wrap" data-ratio="0.69" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1942633_1775309159_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.69" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.69" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1942633_1775309159_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1942633_1775309159_gray.jpeg"> </div><p>哈兰德戴帽，奥赖利造点+助攻，曼城单赛季三杀红军，挺进足总杯半决赛；萨拉赫失点+失单刀。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-05/match1942632date2026vnative.htm" target="_blank" weibo="" mode="1,2">止4连败！切尔西7-0大胜维尔港进足总杯4强 埃斯特旺传射+两中柱</a></p><div class="img_wrap" data-ratio="0.61" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1942632_1775326082_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.61" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.61" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1942632_1775326082_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1942632_1775326082_gray.jpeg"> </div><p>切尔西晋级足总杯4强！埃斯特旺传射，加纳乔点射，佩德罗、哈托、桑托斯建功，恩佐内部停赛。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-04/match1718901date2026vnative.htm" target="_blank" weibo="" mode="1,2">让二追三！拜仁3-2逆转弗赖堡先赛12分领跑 比朔夫双响卡尔绝杀</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1718901_1775317583_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1718901_1775317583_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1718901_1775317583_gray.jpeg"> </div><p>拜仁先赛12分领跑！20岁比朔夫世界波双响追平，18岁卡尔读秒绝杀！</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-04/match1718896date2026vnative.htm" target="_blank" weibo="" mode="1,2">1-3后连入5球！勒沃库森6-3逆转狼堡 格里马尔多双响埃里克森点射</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1718896_1775317599_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1718896_1775317599_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260404/zhanbao_image_1718896_1775317599_gray.jpeg"> </div><p>勒沃库森1-3落后连入5球逆转，继续排名第6，沃尔夫斯堡仍处降级区；格里马尔多双响。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-05/match1718899date2026vnative.htm" target="_blank" weibo="" mode="1,2">补时连进2球！多特2-0斯图加特距榜首9分 阿德耶米、布兰特破门</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1718899_1775327339_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1718899_1775327339_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260405/zhanbao_image_1718899_1775327339_gray.jpeg"> </div><p>补时最后时刻，阿德耶米、布兰特连进2球；斯图加特积53分排名第三，多特蒙德积64分排名第二。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-04-05/match1885614date2026vnative.htm" target="_blank" weibo="" mode="1,2">三连败！U16国足0-1科特迪瓦U16 国足小组3场皆负参加7-8名排位赛</a></p><div class="img_wrap" data-ratio="1.5" data