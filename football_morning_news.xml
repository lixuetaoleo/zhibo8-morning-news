 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/match2067683date2026vnative.htm" target="_blank" weibo="" mode="1,2">笑傲德比！十人曼城1-0客胜曼联 哈兰德制胜福登报复性动作染直红</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2067683_1789321319_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2067683_1789321319_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2067683_1789321319_gray.jpeg"> </div><p>曼城新赛季4轮全胜，曼联4轮仅1胜！哈兰德制胜，福登报复性动作染直红，B费踢人在先未吃牌。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/match2075446date2026vnative.htm" target="_blank" weibo="" mode="1,2">6连胜轰26球！巴萨4-2莱万特 亚马尔连续3轮梅开二度拉菲助攻双响</a></p><div class="img_wrap" data-ratio="0.64" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2075446_1789316259_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.64" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.64" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2075446_1789316259_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2075446_1789316259_gray.jpeg"> </div><p>巴萨开季6连胜狂轰26球；亚马尔连续3轮梅开二度，拉菲尼亚助攻双响，埃斯帕特首球。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/match2075450date2026vnative.htm" target="_blank" weibo="" mode="1,2">马竞3-0客胜皇家社会 格里马尔多点射戴维建功 小西蒙尼破门</a></p><div class="img_wrap" data-ratio="0.67" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2075450_1789332989_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.67" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2075450_1789332989_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2075450_1789332989_gray.jpeg"> </div><p>皇家社会手球送点，格里马尔多点射，戴维和小西蒙尼破门。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/match2057422date2026vnative.htm" target="_blank" weibo="" mode="1,2">赛季首败！尤文2-3萨索洛 阿季奇读秒绝杀热格罗瓦替补双响难救主</a></p><div class="img_wrap" data-ratio="0.61" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2057422_1789331893_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.61" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.61" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2057422_1789331893_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2057422_1789331893_gray.jpeg"> </div><p>尤文遭绝杀后反绝平，之后再被压哨绝杀！热格罗瓦替补双响难救主，尤文联赛两轮不胜。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/match2057419date2026vnative.htm" target="_blank" weibo="" mode="1,2">终结各赛事3连败！那不勒斯1-0博洛尼亚暂升第9 洛博特卡制胜</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2057419_1789320861_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2057419_1789320861_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2057419_1789320861_gray.jpeg"> </div><p>洛博特卡制胜，法瓦苏利送助攻，泰特破门被判越位无效；那不勒斯终结各项赛事3连败。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/match2076779date2026vnative.htm" target="_blank" weibo="" mode="1,2">暂升第4！拜仁2-1埃尔沃斯贝格 凯恩传射+联赛首球卡尔破门</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2076779_1789320507_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2076779_1789320507_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2076779_1789320507_gray.jpeg"> </div><p>凯恩传射+个人联赛首球，18岁卡尔破门，拜仁2胜1平暂时升至第四！</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/match2059504date2026vnative.htm" target="_blank" weibo="" mode="1,2">联赛首胜！巴黎1-0布雷斯特 费兰5场6球登贝莱助攻阿什拉夫伤退</a></p><div class="img_wrap" data-ratio="0.65" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2059504_1789332153_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.65" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.65" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2059504_1789332153_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260914/zhanbao_image_2059504_1789332153_gray.jpeg"> </div><p>费兰闪击+5场6球，登贝莱脚后跟助攻，阿什拉夫伤退，门德斯失误险送礼，萨福诺夫屡次救险。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/6aa7069a62996native.htm" target="_blank" weibo="" mode="1,2">英超承认哈兰德进球判罚存失误：主裁应场边回看 已联系曼联承认</a></p><p>多位记者消息，英格兰职业比赛裁判机构（Pro Ref）发言人表示，哈兰德进球判罚有效存在失误。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/6aa6cf711a771native.htm" target="_blank" weibo="" mode="1,2">英超积分榜：曼城笑傲德比，与枪手均全胜！曼联4轮1胜车军刺全平</a></p><div class="img_wrap" data-ratio="0.36" data="https://tu.duoduocdn.com/uploads/day_260914/202609140126359629.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.36" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.36" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260914/202609140126359629_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260914/202609140126359629_720.jpg"> </div><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/6aa70fe32aebdnative.htm" target="_blank" weibo="" mode="1,2">西甲积分榜：巴萨全胜领跑，皇马4胜1负第二，马竞3胜1平1负</a></p><div class="img_wrap" data-ratio="0.36" data="https://tu.duoduocdn.com/uploads/day_260914/202609140510461387.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.36" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.36" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260914/202609140510461387_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260914/202609140510461387_720.jpg"> </div><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/6aa6cffa9613anative.htm" target="_blank" weibo="" mode="1,2">你给奥利弗几分？争议判罚：B费踢人未吃牌 VAR判哈兰德进球有效</a></p><div class="img_wrap" data-ratio="1.5" data="http://tu.duoduocdn.com/uploads/day_250326/67e3aff788a82.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250326/67e3aff788a82.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250326/67e3aff788a82.jpg"> </div><p>英超第4轮，曼联对阵曼城。本场主裁为奥利弗，他的一些判罚也引发不小争议。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/6aa6dda76699bnative.htm" target="_blank" weibo="" mode="1,2">难道他真是天才？马雷斯卡接手曼城4轮全胜+赢下德比，仅输社区盾</a></p><div class="img_wrap" data-ratio="1.25" data="https://tu.duoduocdn.com/uploads/day_260824/6a8be9f9616fe.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.25" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.25" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260824/6a8be9f9616fe.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260824/6a8be9f9616fe.jpg"> </div><p>曼城主帅马雷斯卡新赛季接手球队，代替了曾执教曼城十年的瓜迪奥拉。新赛季，马雷斯卡率领曼城在联赛中4轮保持全胜，欧冠赛场首轮也取得了胜利，仅在赛季初的社区盾决赛中不敌阿森纳。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/6aa6e066cafa4native.htm" target="_blank" weibo="" mode="1,2">卡圣魔力不再？卡里克上赛季带队获第3并转正，新赛季前四轮仅1胜</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260911/6aa3129425e3d_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260911/6aa3129425e3d_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260911/6aa3129425e3d_720.jpg"> </div><p>今年夏窗，曼联引进了巴莱巴、安德雷·桑托斯和蒂莱曼斯，但卡里克新赛季英超4轮仅1胜1平2负。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-09-14/6aa70316033a2native.htm" target="_blank" weibo="" mode="1,2">心态不错！福登染红后遭曼联球迷嘲讽 离场比“1-0”手势强势回击</a></p><div class="img_wrap" data-ratio="1.25" data="https://