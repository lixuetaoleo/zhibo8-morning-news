 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a6790b394b4bnative.htm" target="_blank" weibo="" mode="1,2">罗马诺：马尔蒂尼辞去意大利技术总监一职，莱昂纳多辞去顾问职务</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260728/202607280111597034.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260728/202607280111597034_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260728/202607280111597034_720.jpg"> </div><p>据罗马诺报道，马尔蒂尼辞去意大利足协技术总监职务，莱昂纳多也不再担任顾问。从官宣上任到两人离职，前后仅仅过去16天。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67b18e8365bnative.htm" target="_blank" weibo="" mode="1,2">Here We Go！罗马诺：32岁斯通斯自由身加盟国米，400万年薪签2年</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260728/202607280329556824_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260728/202607280329556824_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260728/202607280329556824_720.jpg"> </div><p>罗马诺以标志性的“HWG”确认，32岁的前曼城后卫斯通斯将自由身加盟国米。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67a8b121ae4native.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺：特拉福德加盟利兹联，转会费4000万英镑+浮动</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260728/202607280252137540_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260728/202607280252137540_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260728/202607280252137540_720.jpg"> </div><p>名记罗马诺以标志性的“HWG”宣布，曼城门将特拉福德将加盟利兹联。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-27/6a67747254a1dnative.htm" target="_blank" weibo="" mode="1,2">天外飞仙攻破阿根廷！官方：卡布拉尔世界波当选世界杯最佳进球</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260704/6a4853c2394f5_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260704/6a4853c2394f5.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260704/6a4853c2394f5.jpg"> </div><p>国际足联官方宣布，佛得角后卫卡布拉尔在2026世界杯1/16决赛对阵阿根廷的世界波破门，当选美加墨世界杯最佳进球。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67ca9bd4d1bnative.htm" target="_blank" weibo="" mode="1,2">德天空：皇马已向维尼修斯提出新的续约报价，枪手正准备首份报价</a></p><div class="img_wrap" data-ratio="1.35" data="https://tu.duoduocdn.com/uploads/day_260728/202607280520112766_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.35" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.35" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260728/202607280520112766_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260728/202607280520112766_720.jpg"> </div><p>据德国天空体育记者Florian Plettenberg消息，皇马现已向维尼修斯及其团队发出续约反报价。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67940f62506native.htm" target="_blank" weibo="" mode="1,2">罗马诺：切尔西领跑争夺36岁乔丹·亨德森，球员对加盟持开放态度</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260728/202607280125537952_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260728/202607280125537952_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260728/202607280125537952_720.jpg"> </div><p>据罗马诺消息，切尔西领跑36岁乔丹·亨德森的签约争夺战，将其作为新中场引援。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67c77539226native.htm" target="_blank" weibo="" mode="1,2">德天空：皇马谈迪奥曼德仍未达协议，皇马提出的奖金条款难以达成</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260728/202607280508311487.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260728/202607280508311487_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260728/202607280508311487_720.jpg"> </div><p>据德国天空体育记者Florian Plettenberg消息，皇马与莱比锡之间仍未就迪奥曼德达成最终协议，所有相关方均已确认此事。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67a4fa457b4native.htm" target="_blank" weibo="" mode="1,2">巴黎不满迪奥曼德费用：他们竟为一年前还在踢西乙的球员开出天价</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260621/6a36fbd6c98a4.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260621/6a36fbd6c98a4.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260621/6a36fbd6c98a4.jpg"> </div><p>据《队报》报道，巴黎内部对皇马、莱比锡、中间人和球员经纪人在迪奥曼德转会中表现出的态度非常不满。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a6797fb2b0d7native.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺:亨克18岁中场卡雷查斯加盟多特 转会费3300万欧+二转</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/news/day_260728/202607280149014057.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260728/202607280149014057.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260728/202607280149014057.jpg"> </div><p>罗马诺以标志性的here we go确认，卡雷查斯将加盟多特蒙德。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67814756fd8native.htm" target="_blank" weibo="" mode="1,2">电讯报：维尼修斯将极大提升左边锋实力，克伦克不会轻易批准交易</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260625/6a3c573838ef3_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260625/6a3c573838ef3.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260625/6a3c573838ef3.jpg"> </div><p>电讯报表示，如果阿森纳从皇家马德里签下维尼修斯，这几乎肯定会成为英超历史上最大的一笔转会。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67a4d7241cfnative.htm" target="_blank" weibo="" mode="1,2">每体：引进“小蜘蛛”不顺，巴萨欲支付1亿欧转攻克鲁皮惹争议</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_251027/68ff77e6ce81f.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_251027/68ff77e6ce81f.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_251027/68ff77e6ce81f.jpg"> </div><p>据《每日体育报》报道，巴塞罗那内部正在陷入一场关于引进前锋的激烈讨论，争论的焦点是伯恩茅斯前锋克鲁皮。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67a7003130fnative.htm" target="_blank" weibo="" mode="1,2">曼联利好？卫报：为了签罗德里皇马或需筹钱，可能会出售楚阿梅尼</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260308/69ac8d2fd057d_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260308/69ac8d2fd057d.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260308/69ac8d2fd057d.jpg"> </div><p>《卫报》撰文谈及皇马对罗德里的追求，并表示为了签下罗德里，他们可能需要出售楚阿梅尼来筹集资金。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67bb15261dbnative.htm" target="_blank" weibo="" mode="1,2">埃及足协主席：赛后埃及无人去要梅西球衣，他们有人来要萨拉赫的</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_260728/202607280410065355_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260728/202607280410065355_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260728/202607280410065355_720.jpg"> </div><p>埃及足协官方推特转发了一段由埃及足协主席哈尼·阿布·里达在电视演讲中发布的讲话，其中他再次提及美加墨世界杯中，埃及2-3不敌阿根廷的淘汰赛。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-28/6a67a060acae9native.htm" target="_blank" weibo="" mode="1,2">英超新规！官方：若队医进场治疗门将，教练需指定另1人离场1分钟</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260727/6a676addbcafc.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="backgro