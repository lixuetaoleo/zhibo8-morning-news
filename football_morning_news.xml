 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【友谊赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-25/match1982259date2026vnative.htm" target="_blank" weibo="" mode="1,2">18名小将登场！拜仁1-2德丙球队韦恩 比朔夫点射乌尔赖希“下蛋”</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260725/zhanbao_image_1982259_1784993035_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260725/zhanbao_image_1982259_1784993035_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260725/zhanbao_image_1982259_1784993035_gray.jpeg"> </div><p><span style=" 51, 51);">拜仁友谊赛1-2不敌德丙球队韦恩，下场热身赛将战K联赛球队济州SK。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-25/match2059377date2026vnative.htm" target="_blank" weibo="" mode="1,2">AC米兰2-2凯尔特人 18岁卡马达5分钟双响救主阿莫林迎执教首秀</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260725/zhanbao_image_2059377_1784994150_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260725/zhanbao_image_2059377_1784994150_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260725/zhanbao_image_2059377_1784994150_gray.jpeg"> </div><p><span style=" 51, 51);">18岁卡马达5分钟双响救主，AC米兰客场2-2战平凯尔特人，阿莫林迎来执教米兰首秀。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/match2051479date2026vnative.htm" target="_blank" weibo="" mode="1,2">尤文1-0客胜标准列日 米雷蒂替补任意球制胜+错失空门良机</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260726/zhanbao_image_2051479_1785008683_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260726/zhanbao_image_2051479_1785008683_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260726/zhanbao_image_2051479_1785008683_gray.jpeg"> </div><p><span style=" 51, 51);">米雷蒂替补登场任意球破门，随后错失一次空门机会。最终尤文在友谊赛中1-0击败标准列日。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a6535b2e18b4native.htm" target="_blank" weibo="" mode="1,2">这才季前热身第一场！戈麦斯开场9分钟伤退，恩杜库登场</a></p><div class="img_wrap" data-ratio="1.59" data="https://tu.duoduocdn.com/uploads/day_260726/202607260620454536.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.59" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.59" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260726/202607260620454536_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260726/202607260620454536_720.jpg"> </div><p><span style=" 0, 0);">季前热身赛首战，利物浦对阵桑德兰，开场仅仅9分钟后卫乔·戈麦斯受伤，恩杜库替补登场！</span></p><p><strong><span style=" 51, 51);">【赛后声音】</span></strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a64e2ef8e5fcnative.htm" target="_blank" weibo="" mode="1,2">首战2-2凯尔特人！阿莫林：非常信任卡马达 希拉有不适但问题不大</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260726/6a64e3b18408c.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260726/6a64e3b18408c.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260726/6a64e3b18408c.jpg"> </div><p><span style=" 0, 0);">米兰在首场夏季热身赛中以2比2战平凯尔特人。赛后，米兰主帅阿莫林接受采访。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a651ed2e2311native.htm" target="_blank" weibo="" mode="1,2">卡马达：续约米兰对我来说是份极大的骄傲 阿莫林带来很多新思路</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_231126/65625222b7ab1.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_231126/65625222b7ab1.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_231126/65625222b7ab1.jpg"> </div><p><span style=" 0, 0);">米兰在季前热身赛2-2战平凯尔特人。赛后，本场打入两球的卡马达接受采访。</span></p><p><strong>【足球资讯动态】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-25/6a64b0823d246native.htm" target="_blank" weibo="" mode="1,2">合同剩1年！DO独家：若维尼修斯不与皇马续约 阿森纳考虑签下球员</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260723/6a62291996343_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260723/6a62291996343.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260723/6a62291996343.jpg"> </div><p><span style=" 0, 0);">据The Athletic名记奥恩斯坦独家报道，若维尼修斯不与皇马续约，阿森纳考虑签下这名巴西球员，俱乐部间尚未正式谈判。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a64e975bedeanative.htm" target="_blank" weibo="" mode="1,2">上树！ESPN：如果皇马放人，维尼修斯唯一可能的下家只有阿森纳</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260625/6a3c6097188fb_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260625/6a3c6097188fb.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260625/6a3c6097188fb.jpg"> </div><p><span style=" 0, 0);">ESPN获悉，如果维尼修斯与皇马未能就新合同达成协议并因此离队，那么阿森纳将是今年夏天他唯一可能的目的地。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a6509fcbbd86native.htm" target="_blank" weibo="" mode="1,2">罗马诺：皇马与迪奥曼德就五年合同个人条款达协议！准备再次报价</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260726/202607260310044280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260726/202607260310044280_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260726/202607260310044280_720.jpg"> </div><p><span style=" 0, 0);">据名记罗马诺报道，皇马已经与莱比锡边锋扬·迪奥曼德就个人条款达成协议。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-25/6a64d592b399fnative.htm" target="_blank" weibo="" mode="1,2">电讯报：穆里尼奥告知皇马，他想留住队内核心，反对放走维尼修斯</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260218/6995b8abbca79.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260218/6995b8abbca79.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260218/6995b8abbca79.jpg"> </div><p><span style=" 0, 0);">《每日电讯报》报道，重新回归皇马执教的穆里尼奥已告知俱乐部，希望队内所有核心球星留队，他将反对阿森纳今夏签下维尼修斯。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a64e2c8de0efnative.htm" target="_blank" weibo="" mode="1,2">每体：维尼修斯提出3000万欧税前年薪及1500万忠诚奖，老佛爷不满</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_251228/69511e001936d.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_251228/69511e001936d.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_251228/69511e001936d.jpg"> </div><p><span style=" 0, 0);">多家媒体报道，阿森纳有意皇马前锋维尼修斯，巴西球星的合同明夏就将到期。《每日体育报》表示，弗洛伦蒂诺对维尼修斯的续约条件感到不满。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a64ea65c9d04native.htm" target="_blank" weibo="" mode="1,2">打造无敌中场？阿斯：巴黎介入罗德里争夺战，球员在评估多份报价</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260308/69ad55b4d862c.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260308/69ad55b4d862c.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260308/69ad55b4d862c.jpg"> </div><p><span style=" 0, 0);">《阿斯报》消息，巴黎圣日耳曼强势介入曼城中场罗德里的转会争夺。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-07-26/6a6519a0a674fnative.htm" target="_blank" weibo="" mode="1,2">记者：新月准备为迪亚斯出价1.2-1.5亿刀！开出税后2500万欧年薪</a></p><div class="img_wrap" data-ratio="0.74" data="https://tu.duoduocdn.com/uploads/day_260726/202607260416456796.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.74" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1e