 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【曼城加冕足总杯冠军】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-16/match1972711date2026vnative.htm" target="_blank" weibo="" mode="1,2">夺足总杯冠军！曼城1-0切尔西 塞梅尼奥脚后跟破门制胜裁判引争议</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260516/zhanbao_image_1972711_1778946399_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260516/zhanbao_image_1972711_1778946399_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260516/zhanbao_image_1972711_1778946399_gray.jpeg"> </div><p>塞梅尼奥脚后跟破门制胜，哈兰德助攻，曼城时隔两年再夺足总杯冠军，切尔西近四次足总杯决赛全败。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-16/6a08904ca1be5native.htm" target="_blank" weibo="" mode="1,2">城就双冠！曼城夺队史第8座足总杯冠军，瓜氏曼城10年已收获20冠</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260516/202605162344271348.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260516/202605162344271348.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260516/202605162344271348.jpg"> </div><p>足总杯决赛，曼城1-0战胜切尔西，曼城夺队史第8座足总杯冠军。本赛季曼城夺得足总杯+联赛杯双冠，至此瓜氏曼城10年已收获20冠。</p><p><strong>【C罗无缘亚冠2冠军】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-17/match1971684date2026vnative.htm" target="_blank" weibo="" mode="1,2">憾失亚冠二级冠军！胜利0-1大阪钢巴 胜利20射门未果菲利克斯中柱</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260517/zhanbao_image_1971684_1778959039_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260517/zhanbao_image_1971684_1778959039_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260517/zhanbao_image_1971684_1778959039_gray.jpeg"> </div><p>利雅得胜利0-1大阪钢巴，胜利本赛季三项杯赛均出局，仅剩联赛冠军可争。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-17/6a08b840e2331native.htm" target="_blank" weibo="" mode="1,2">3杯赛均无缘！胜利错失亚冠2级冠军 C罗胜利生涯仍无主要赛事冠军</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_250517/6828470b8c2d9.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_250517/6828470b8c2d9.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_250517/6828470b8c2d9.jpg"> </div><p>C罗自2023年初加盟利雅得胜利后至今，除阿拉冠外，还未在主要赛事中获得过冠军。</p><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-16/match1718953date2026vnative.htm" target="_blank" weibo="" mode="1,2">34轮122球！拜仁5-1科隆 89分收官 凯恩戴帽+赛季58球破纪录</a></p><div class="img_wrap" data-ratio="0.66" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260516/zhanbao_image_1718953_1778945402_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.66" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.66" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260516/zhanbao_image_1718953_1778945402_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260516/zhanbao_image_1718953_1778945402_gray.jpeg"> </div><p><span>凯恩戴帽破纪录，基米希2助攻，格雷茨卡主场谢幕。拜仁联赛89分夺冠收官。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-17/match1741482date2026vnative.htm" target="_blank" weibo="" mode="1,2">不败收官！本菲卡3-1客胜埃斯托里尔 里奥斯、拉法·席尔瓦破门</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260517/zhanbao_image_1741482_1778966897_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260517/zhanbao_image_1741482_1778966897_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260517/zhanbao_image_1741482_1778966897_gray.jpeg"> </div><p>里奥斯、亚历山大·巴、拉法·席尔瓦16分钟连进三球；本菲卡赛季23胜11平积80分不败收官。</p><p><strong>【热门新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-17/6a089ecef01dcnative.htm" target="_blank" weibo="" mode="1,2">Here We Go！罗马诺：阿隆索将执教切尔西，签约4年并参与转会</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260517/202605170114578800.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260517/202605170114578800.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260517/202605170114578800.jpg"> </div><p>名记罗马诺用标志性的Here We Go确认，前皇马主帅哈维·阿隆索将执教切尔西。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-17/6a08d23906936native.htm" target="_blank" weibo="" mode="1,2">记者：阿隆索在切尔西头衔是经理，将深度参与引援等事宜</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_250627/685e61aa50723.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_250627/685e61aa50723.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_250627/685e61aa50723.jpg"> </div><p>记者Ben Jacobs消息，阿隆索在切尔西的头衔将经理（manager），而不是主教练（head coach） 。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-16/6a089027e9565native.htm" target="_blank" weibo="" mode="1,2">新赛季首冠！无论英超结果如何，下赛季社区盾确定为曼城vs阿森纳</a></p><div class="img_wrap" data-ratio="1.38" data="https://tu.duoduocdn.com/uploads/day_250203/67a0578593959.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.38" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%