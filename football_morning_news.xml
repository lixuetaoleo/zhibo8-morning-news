 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-27/match2075410date2026vnative.htm" target="_blank" weibo="" mode="1,2">姆巴佩戴帽！皇马4-1皇社取联赛两连胜 维尼修斯传射贝林两助攻</a></p><div class="img_wrap" data-ratio="0.64" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2075410_1787777147_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.64" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.64" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2075410_1787777147_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2075410_1787777147_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">皇马主场4-1战胜皇社，皇马开局取得联赛两连胜，下轮将对阵马拉加。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-27/match2138379date2026vnative.htm" target="_blank" weibo="" mode="1,2">热刺5-1大胜查尔顿 萨维尼奥首秀替补3分钟传射 米奇·摩尔造2球</a></p><div class="img_wrap" data-ratio="0.62" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2138379_1787776645_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.62" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.62" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2138379_1787776645_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2138379_1787776645_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">萨维尼奥替补首秀3分钟1传1射，热刺5-1大胜查尔顿，晋级联赛杯下一轮。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-27/6a8f09263e532native.htm" target="_blank" weibo="" mode="1,2">明天抽签！欧冠36强出炉：费内巴切时隔18年重返，挪超2队晋级</a></p><div class="img_wrap" data-ratio="0.8" data="http://tu.duoduocdn.com/uploads/day_260827/202608270642241995.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_260827/202608270642241995_720.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_260827/202608270642241995_720.jpg"> </div><p><span style="color: rgb(0, 0, 0);">随着欧冠附加赛对决全部收官，2026/27赛季欧冠36支正赛球队正式全部敲定。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-27/match2138375date2026vnative.htm" target="_blank" weibo="" mode="1,2">赛季首胜！纽卡3-2西布朗挺进联赛杯第3轮 图雷破门巴恩斯双响</a></p><div class="img_wrap" data-ratio="0.67" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2138375_1787775991_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.67" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2138375_1787775991_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260827/zhanbao_image_2138375_1787775991_gray.jpeg"> </div><p><span style="color: rgb(51, 51, 51);">纽卡斯尔联以3-2击败西布朗，挺进联赛杯第3轮。</span></p><p><strong>【赛后声音】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-27/6a8f5ad7c0874native.htm" target="_blank" weibo="" mode="1,2">穆帅：我不喜欢单独点评球员，但姆巴佩今天表现真的太疯狂</a></p><div class="img_wrap" data-ratio="1.91" data="https://tu.duoduocdn.com/uploads/day_260827/202608270531315343.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.91" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.91" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260827/202608270531315343.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260827/202608270531315343.jpg"> </div><p><span style="color: rgb(0, 0, 0);">西甲首轮补赛，皇马4-1大胜皇家社会，穆里尼奥赛后接受了俱乐部电台的采访，大赞姆巴佩表现。</span></p><p><strong>【重要转会动态】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-27/6a8f32b91089cnative.htm" target="_blank" weibo="" mode="1,2">官方：纽卡签下24岁曼城中场尼科·冈萨雷斯，转会总价5000万英镑</a></p><div class="img_wrap" data-ratio="1.33" data="https://tu.duoduocdn.com/uploads/day_260827/202608270239589520_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.33" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.33" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260827/202608270239589520_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260827/202608270239589520_720.jpg"> </div><p><span style="color: rgb(0, 0, 0);">官方消息，曼城中场尼科·冈萨雷斯转会纽卡，球员将身披6号球衣。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-27/6a8f345b3bbd8native.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺：新月签下维拉前锋沃特金斯，转会费总价6040万欧</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260827/202608270247255658_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260827/202608270247255658_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260827/202608270247255658_720.jpg"> </div><p><span style="color: rgb(0, 0, 0);">罗马诺以标志性的“HWG”宣布，新月签下维拉前锋沃特金斯，转会费总价6040万欧！</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-26/6a8f03ff07987native.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺：巴萨后卫福特加盟皇家社会，转会费800万欧+50%二转</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260826/202608262320379550_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260826/202608262320379550_1280.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260826/202608262320379550_1280.jpg"> </div><p><span style="color: rgb(0, 0, 0);">名记罗马诺以标志性的“here we go”宣布，20岁巴萨后卫福特加盟皇家社会，转会费800万欧+50%二转+2000万欧回购。</span></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-26/6a8effe3c362anative.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺：国米中场阿斯拉尼先租后买加盟阿布扎比半岛</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/news/day_260826/202608262302596511.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-s