 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/match1949488date2026vnative.htm" target="_blank" weibo="" mode="1,2">3连胜！葡萄牙4-2丹麦 拉莫斯传射B费两助攻霍伊伦进球后SIU庆祝</a></p><div class="img_wrap" data-ratio="0.59" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949488_1790887561_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.59" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.59" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949488_1790887561_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949488_1790887561_gray.jpeg"> </div><p>霍伊伦进球后“SIU”庆祝，拉莫斯传射，B费2助攻，菲利克斯替补破门；葡萄牙获新帅治下3连胜。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/match1949486date2026vnative.htm" target="_blank" weibo="" mode="1,2">渣叔治下首胜！德国2-0塞尔维亚 比朔夫国家队处子球维尔茨建功</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949486_1790887533_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949486_1790887533_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949486_1790887533_gray.jpeg"> </div><p>德国取克洛普治下首胜！维尔茨破门，比朔夫国家队首球，沃尔特马德失良机。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/match1949485date2026vnative.htm" target="_blank" weibo="" mode="1,2">让二追二！荷兰2-2绝平希腊 赖因德斯替补破门范戴克头球建功</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949485_1790887724_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949485_1790887724_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949485_1790887724_gray.jpeg"> </div><p>荷兰上演让二追二，哈维上任3场1胜2平；赖因德斯绝平，范戴克建功；措利斯伤退。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/match1949487date2026vnative.htm" target="_blank" weibo="" mode="1,2">威尔士2-1逆转10人挪威 丹尼尔·詹姆斯破门 黑格姆直红</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949487_1790897089_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949487_1790897089_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20261002/zhanbao_image_1949487_1790897089_gray.jpeg"> </div><p>厄德高送助攻，鲍勃、丹尼尔·詹姆斯破门，黑格姆直红。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/match2304871date2026vnative.htm" target="_blank" weibo="" mode="1,2">第83分钟遭绝杀！U17国足0-1坦桑尼亚U17 U17国足下场将战墨西哥</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_261002/202610020226483255.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261002/202610020226483255.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261002/202610020226483255.jpg"> </div><p>Vertex Cup邀请赛，U17国足对阵坦桑尼亚U17。比赛第83分钟，坦桑尼亚U17打进全场比赛唯一进球。U17国足下一场比赛时间为北京时间10月4日21:00，对手为墨西哥U17。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/6abec4d86591bnative.htm" target="_blank" weibo="" mode="1,2">欧青赛预选赛：西班牙13-0血洗圣马力诺，皇马小将埃斯皮狂轰5球</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/news/day_261002/202610020450088093.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_261002/202610020450088093.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_261002/202610020450088093.jpg"> </div><p>U21欧青赛预选赛，西班牙以13-0的比分血洗弱旅圣马力诺。西班牙U21在这组预选赛里目前8战7胜1负，进27球丢4球，排小组第一。</p><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/6abeba60c9d60native.htm" target="_blank" weibo="" mode="1,2">获得支持！部分葡萄牙球迷在看台拼出“爱你，热苏斯”力挺新帅</a></p><div class="img_wrap" data-ratio="0.8" data="https://tu.duoduocdn.com/uploads/day_261002/202610020358095851.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.8" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.8" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261002/202610020358095851_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261002/202610020358095851_720.jpg"> </div><p>自C罗自宣退出本期集训后，部分葡萄牙球迷对热苏斯的执教安排表达不满，但现场也有支持者用特别的方式声援主帅</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/6abed1eaa64e5native.htm" target="_blank" weibo="" mode="1,2">刚用siu致敬C罗，霍伊伦赛后上手轻推了一下葡萄牙主帅</a></p><div class="img_wrap" data-ratio="1.63" data="https://tu.duoduocdn.com/uploads/day_261002/202610020554391815.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.63" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261002/202610020554391815_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261002/202610020554391815_720.jpg"> </div><p>欧国联第三轮丹麦2-4不敌葡萄牙，终场哨响后，霍伊伦推搡了葡萄牙国家队主帅热苏斯。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/6abed98bcef7fnative.htm" target="_blank" weibo="" mode="1,2">接过7号！莱奥：我只想不辜负这件球衣；相信C罗在家也为取胜高兴</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_261002/202610020608595517.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261002/202610020608595517_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261002/202610020608595517_720.jpg"> </div><p>欧国联A4组第3轮，葡萄牙客场4-2击败丹麦。赛后，本场身穿葡萄牙7号球衣出战的莱奥在混合采访区接受采访，谈到了这个号码的特殊意义、C罗离开国家队集训营以及球队的表现。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/6abed2f2e1166native.htm" target="_blank" weibo="" mode="1,2">热苏斯：有些球员地位特殊但规则人人一样，我一直这么想也会坚持</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_261002/6abed387c909e_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_261002/6abed387c909e_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_261002/6abed387c909e_720.jpg"> </div><p>欧国联A4组第3轮，葡萄牙客场4-2击败丹麦。赛后，葡萄牙主帅若热·热苏斯出席新闻发布会，谈到了球队表现、球员管理以及自己的战术理念。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/6abecfd0cb550native.htm" target="_blank" weibo="" mode="1,2">热苏斯：有些事情是发生了，但这些事情没有分裂，也不会分裂我们</a></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-10-02/6abe8e5e98826native.htm" target="_blank" weibo="" mode="1,2">“梅老板”！官方：梅西正式收购西乙球队埃登斯100%股份</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/day_261002/202610020047525607.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="