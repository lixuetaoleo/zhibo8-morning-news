 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【热点新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a83516909ee0native.htm" target="_blank" weibo="" mode="1,2">罗德里：在巴萨踢球是我的梦想 我们要为欧冠和一切而战</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/day_260818/202608180228489337.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.78" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.78" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260818/202608180228489337.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260818/202608180228489337.jpg"> </div><p>罗德里抵达巴塞罗那，他出机场后接受了记者采访。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a836679224f5native.htm" target="_blank" weibo="" mode="1,2">罗马诺：费尔明提出把16号让给罗德里，自己将接过费兰留下的7号</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260616/6a302890b0dca.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260616/6a302890b0dca.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260616/6a302890b0dca.jpg"> </div><p>罗马诺在自己的频道更新了视频，谈到了罗德里球衣号码的情况。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a8390b487cfanative.htm" target="_blank" weibo="" mode="1,2">HWG！罗马诺：罗马签19岁波尔图中场莫拉，转会费2500万+50%二转</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260818/202608180654313795_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260818/202608180654313795_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260818/202608180654313795_720.jpg"> </div><p>罗马诺以标志性的“Here We Go”确认，罗马就签下19岁波尔图中场罗德里戈·莫拉达成口头协议！</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a834a4809ecdnative.htm" target="_blank" weibo="" mode="1,2">RMC：利物浦与18岁姆巴耶达5年协议，将继续谈打包签他和巴尔科拉</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260617/6a31b6ab5496e.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260617/6a31b6ab5496e.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260617/6a31b6ab5496e.jpg"> </div><p>据RMC Sport记者Fabrice Hawkins独家消息，利物浦已与18岁巴黎前锋姆巴耶达成协议，并希望同时签下姆巴耶和巴尔科拉。他们将继续与巴黎进行谈判，力求完成这笔潜在的打包交易。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a8341d886ecdnative.htm" target="_blank" weibo="" mode="1,2">英媒：伯利与沃尔特愿将其切尔西股份卖给清湖，俱乐部估值50亿镑</a></p><div class="img_wrap" data-ratio="1.38" data="https://tu.duoduocdn.com/uploads/day_250821/68a6ccc14f17c.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.38" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.38" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_250821/68a6ccc14f17c.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_250821/68a6ccc14f17c.jpg"> </div><p>据《电讯报》报道，伯利和马克·沃尔特有意将其持有的切尔西俱乐部股份出售给大股东清湖资本，这笔交易对俱乐部的估值将超过50亿英镑。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a832d27b7f05native.htm" target="_blank" weibo="" mode="1,2">英超官方：不采纳捂嘴红牌规则；门将受伤需指定一人离场一分钟</a></p><div class="img_wrap" data-ratio="1.32" data="https://tu.duoduocdn.com/uploads/day_190219/5c6c25fba05e4.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.32" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.32" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_190219/5c6c25fba05e4.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_190219/5c6c25fba05e4.jpg"> </div><p>新赛季英超本周末就将打响，英超官方对26/27赛季英超的一些规则变更做出了解释。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a83375a138cenative.htm" target="_blank" weibo="" mode="1,2">也想来？罗德里和坎塞洛即将加盟巴萨，拉波尔特点赞罗马诺报道</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260818/202608180031338913.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260818/202608180031338913_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260818/202608180031338913_720.jpg"> </div><p>罗德里和坎塞洛即将加盟巴萨，其中坎塞洛已经巴塞罗那，罗德里也已出发，拉波尔特点赞了罗马诺的相关报道。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a833759a9330native.htm" target="_blank" weibo="" mode="1,2">前经纪人：巴萨曾拒绝2000万欧签河床的小蜘蛛，反而6000万签费兰</a></p><div class="img_wrap" data-ratio="1.79" data="https://tu.duoduocdn.com/uploads/news/day_260818/202608180036434995.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.79" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.79" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260818/202608180036434995.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260818/202608180036434995.jpg"> </div><p>前巴萨高管、曾是资深经纪人的何塞普·马利亚·明格利亚在接受《每日体育报》采访时透露，他曾在阿尔瓦雷斯还在为河床效力时推荐巴萨签下这名球员。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a835b890081fnative.htm" target="_blank" weibo="" mode="1,2">记者：莱奥被推荐至罗马，由经纪人门德斯今日代表米兰向罗马举荐</a></p><div class="img_wrap" data-ratio="1.38" data="https://tu.duoduocdn.com/uploads/day_251020/68f54ee550988.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.38" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.38" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_251020/68f54ee550988.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_251020/68f54ee550988.jpg"> </div><p>据记者Sacha Tavolieri独家消息，经纪人豪尔赫·门德斯代表AC米兰向罗马举荐了莱奥。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a8367425a51enative.htm" target="_blank" weibo="" mode="1,2">罗马诺：切尔西对内托估价达到1亿英镑，曼城认为要价过高</a></p><div class="img_wrap" data-ratio="1.53" data="https://tu.duoduocdn.com/uploads/day_241111/673160f7494f5.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.53" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.53" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_241111/673160f7494f5.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_241111/673160f7494f5.jpg"> </div><p>罗马诺在自己的频道更新了视频，谈到了切尔西边锋内托的情况。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a8379a5138c2native.htm" target="_blank" weibo="" mode="1,2">迪马：莫雷拉今天接受米兰体检，转会费为4500万欧+2000万欧奖金</a></p><div class="img_wrap" data-ratio="0.81" data="https://tu.duoduocdn.com/uploads/day_260818/202608180515279860_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.81" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.81" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260818/202608180515279860_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260818/202608180515279860_720.jpg"> </div><p>据迪马济奥消息，米兰签下莫雷拉的转会费总价为6500万欧。米兰新边锋迭戈·莫雷拉周二将抵达意大利接受体检。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a837eb6a4cbbnative.htm" target="_blank" weibo="" mode="1,2">德媒：3人自称居莱尔表兄弟，闯入球员通道、辱骂殴打沙尔克员工</a></p><div class="img_wrap" data-ratio="1.3" data="https://tu.duoduocdn.com/uploads/day_260818/202608180536099518.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.3" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.3" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260818/202608180536099518_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260818/202608180536099518_720.jpg"> </div><p>据《图片报》报道，有3人自称是居莱尔的表兄弟，在球员通道大闹，辱骂、殴打员工。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-18/6a837fb4cacf6native.htm" target="_blank" weibo="" mode="1,2">宝刀不老！37岁奥巴梅扬拉科鲁尼亚首秀破门，上演空翻庆祝</a></p><div class="img_wrap" data-ratio="1.6" data="https://tu.duoduocdn.com/uploads/news/day_260818/202608180542146189.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.6" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.6" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260818/202608180542146189.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260818/202608180542146189.jpg"> </div><p>拉科鲁尼亚主场1-1战平埃尔切。37岁奥巴梅扬此役首发出战，上演拉科鲁尼亚首秀，并取得进球，帮助球队拿到1分。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-17/6a83229c536a3native.htm" target="_blank" weibo="" mode="1,2">EAFC27球员评分公布：姆、哈91分最高，梅西暴涨至89，亚马尔90</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/day_260817/202608172324046604.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.78" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.78" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260817/202608172324046604_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260817/202608172324046604_720.jpg"> </div><p>美国艺电公司旗下足球游戏EAFC27公布了本年度的球员评分TOP27，姆巴佩、哈兰德以91分并列第一。梅西从上一代的86分暴涨至89分，亚马尔、贝林90分，B费、维尼修斯89分，赖斯、萨利巴88分。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-17/6a83252ff10ddnative.htm" target="_blank" weibo="" mode="1,2">31岁无球可踢！镜报：斯特林一边寻找新东家一边在青训执教</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260227/69a1b24a25cce.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260227/69a1b24a25cce.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260227/69a1b24a25cce.jpg"> </div><p>据《镜报》报道，今夏成为自由身的31岁斯特林目前无球可踢，正在自己的青训营中指导年轻球员踢球。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-17/6a83243658e65native.htm" target="_blank" weibo="" mode="1,2">提前一天！中超官方：第25轮申花vs泰山调整为8月28日19点35开球</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260817/202608172310175654_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_o