 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/match1942362date2026vnative.htm" target="_blank" weibo="" mode="1,2">火药味十足！十人葡萄牙2-1十人智利 莱奥、罗曼互殴染红 B费破门</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1942362_1780775240_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.72" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.72" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1942362_1780775240_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1942362_1780775240_gray.jpeg"> </div><p>双方各染一红！坎塞洛推人后被踢裆引冲突，莱奥推搡对手双方均被罚下；B费世界波，格德斯破门。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/match1868258date2026vnative.htm" target="_blank" weibo="" mode="1,2">友谊赛-德国2-1美国 哈弗茨传射萨内建功 安东尼·罗宾逊世界波</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1868258_1780776801_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1868258_1780776801_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1868258_1780776801_gray.jpeg"> </div><p>哈弗茨传射，萨内破门，基米希送助攻，安东尼·罗宾逊世界波。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/match1942399date2026vnative.htm" target="_blank" weibo="" mode="1,2">友谊赛-英格兰1-0小胜新西兰 凯恩头球制胜 丹·伯恩中柱</a></p><div class="img_wrap" data-ratio="0.75" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1942399_1780782621_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1942399_1780782621_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260607/zhanbao_image_1942399_1780782621_gray.jpeg"> </div><p>凯恩破门，斯彭斯助攻，丹·伯恩中柱；英格兰下一场友谊赛将迎战哥斯达黎加。</p><p><strong>【热门新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/6a24695ca8922native.htm" target="_blank" weibo="" mode="1,2">友谊赛打架！坎塞洛推人后遭踢裆双方爆冲突 莱奥、罗曼均被罚下</a></p><p>葡萄牙vs智利上半场补时阶段，双方爆发冲突，莱奥和智利球员伊万·罗曼都被罚下，双方有激烈的推搡动作。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/6a2484148252dnative.htm" target="_blank" weibo="" mode="1,2">这动作！小维阿双脚飞铲放翻劳姆，引发德国＆美国双方队员冲突</a></p><p>足球友谊赛，德国2-1美国。比赛补时阶段，小维阿在拼抢时飞铲劳姆，后者直接被铲飞，引发了德国队员的不满，安东、塔等人纷纷上去要说法。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/6a248f3f0efa3native.htm" target="_blank" weibo="" mode="1,2">加入争夺！阿斯：穆帅希望B席加盟皇马，球员此前曾被高层否决</a></p><div class="img_wrap" data-ratio="1.42" data="https://tu.duoduocdn.com/uploads/day_260305/69a98c3b2d4a4.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.42" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.42" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260305/69a98c3b2d4a4.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260305/69a98c3b2d4a4.jpg"> </div><p>据《阿斯报》消息，穆里尼奥将B席列入了他的引援名单。尽管皇马高层此前曾拒绝过这名球员，但穆里尼奥的意愿可能会改变原有计划。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/6a245bdf8541fnative.htm" target="_blank" weibo="" mode="1,2">金球先生入主沙特？沙特媒：新月准备与巴黎谈判登贝莱并提出报价</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_260531/6a1bac156f064.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260531/6a1bac156f064.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260531/6a1bac156f064.jpg"> </div><p>据沙特媒体《体育报》独家消息源报道，利雅得新月管理层已向巴黎正式发函，请求引进登贝莱。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/6a2470de6a054native.htm" target="_blank" weibo="" mode="1,2">皇马大选今日投票！老佛爷承诺1.5亿报价超巨 里克尔梅要签哈兰德</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/news/day_260607/202606070320354948.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.78" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.78" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/news/day_260607/202606070320354948.jpg" alt="" src="https://tu.duoduocdn.com/uploads/news/day_260607/202606070320354948.jpg"> </div><p>皇家马德里的主席大选今天（6月7日）将正式开始投票，投票时间为当地时间的上午9点至晚上8点，地点为皇马篮球馆。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-06-07/6a2471545b459native.htm" target="_blank" weibo="" mode="1,2">里克尔梅：我肯定克洛普会来皇马，主席插手更衣室才导致他不肯来</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/day_260607/202606070316446851_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.78" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  