 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【中国男足U17获亚洲杯亚军】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/match1984080date2026vnative.htm" target="_blank" weibo="" mode="1,2">憾失冠军！U17中国连追两球2-3日本 万项破门赵松源替补造点+点射</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260523/202605230420495824.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260523/202605230420495824.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260523/202605230420495824.jpg"> </div><p>国少收获U17亚洲杯亚军！万项破门，赵松源替补点射建功，帅惟浩献助攻。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a1083ad1fc12native.htm" target="_blank" weibo="" mode="1,2">近10届最好成绩！国少获U17亚洲杯亚军，11月将出战U17世界杯</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260523/202605230416428512.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260523/202605230416428512.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260523/202605230416428512.jpg"> </div><p>U17亚洲杯决赛，U17男足2-3不敌日本U17，收获亚军，这也是国少近10届U17亚洲杯的最好成绩。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a1086be9b183native.htm" target="_blank" weibo="" mode="1,2">22年！中国男足国字号在亚洲仍3次夺冠，上一次还是04年U17亚少赛</a></p><div class="img_wrap" data-ratio="1.33" data="https://tu.duoduocdn.com/uploads/day_260122/202601221608079508.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.33" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.33" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260122/202601221608079508.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260122/202601221608079508.jpg"> </div><p>迄今为止中国国字号男足在亚洲舞台上夺得冠军次数仍是3次。此前的三次冠军分别是：1985年U19亚青赛冠军、1992年U17亚少赛冠军和2004年U17亚少赛冠军。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a10a73638c41native.htm" target="_blank" weibo="" mode="1,2">媒体人热议U17国足亚洲杯获亚军：虽败犹荣 未来一定会变得更好</a></p><div class="img_wrap" data-ratio="0.56" data="https://tu.duoduocdn.com/uploads/day_260523/202605230311412583.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.56" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.56" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260523/202605230311412583.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260523/202605230311412583.jpg"> </div><p>U17亚洲杯决赛，U17国足2-3不敌日本获得亚军。媒体人赛后热议U17国足亚洲杯获得亚军。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a10a95fec9b7native.htm" target="_blank" weibo="" mode="1,2">2-3惜败失冠！周雨诺：我们和日本各打一个精彩半场，为球队骄傲</a></p><div class="img_wrap" data-ratio="1.78" data="https://tu.duoduocdn.com/uploads/day_260523/202605230308028578.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.78" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.78" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260523/202605230308028578_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260523/202605230308028578_720.jpg"> </div><p>U17亚洲杯决赛，中国队2-3惜败日本。赛后，队长周雨诺接受采访。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a10af321a48dnative.htm" target="_blank" weibo="" mode="1,2">贺炜寄语U17国足：长城也曾是山坡上散落的石头 粘合起来终成脊梁</a></p><div class="img_wrap" data-ratio="0.67" data="https://tu.duoduocdn.com/uploads/day_260523/202605230334193582.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.67" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260523/202605230334193582.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260523/202605230334193582.jpg"> </div><p>U17亚洲杯决赛，U17国足不敌日本收获赛事亚军。赛后，央视解说员贺炜在解说时寄语U17国足。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a10a702cec44native.htm" target="_blank" weibo="" mode="1,2">无缘亚少赛冠军！中国队将有7人获“运动健将”资格</a></p><div class="img_wrap" data-ratio="1.5" data="https://tu.duoduocdn.com/uploads/day_251201/692cf743049ca.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.5" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.5" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_251201/692cf743049ca.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_251201/692cf743049ca.jpg"> </div><p>U17亚洲杯决赛，中国队2-3憾负日本，夺得亚军。</p><p><strong>【热门新闻】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-22/6a10768c1efcfnative.htm" target="_blank" weibo="" mode="1,2">结束5年皇马生涯！官方：阿拉巴赛季末离队，末轮伯纳乌向他致敬</a></p><div class="img_wrap" data-ratio="1.55" data="https://tu.duoduocdn.com/uploads/day_260522/202605222340194616.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="1.55" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.55" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260522/202605222340194616_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260522/202605222340194616_720.jpg"> </div><p>皇马官方发布公告，阿拉巴将于赛季末离队，结束5年皇马生涯。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a10a8da9f8c3native.htm" target="_blank" weibo="" mode="1,2">Here We Go！罗马诺：切尔西将签白堡中场巴尔科，6月正式引进</a></p><div class="img_wrap" data-ratio="0.75" data="https://tu.duoduocdn.com/uploads/day_260523/202605230307415472_1280.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.75" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.75" forbiden_android=">" t-rc="https://tu.duoduocdn.com/uploads/day_260523/202605230307415472_720.jpg" alt="" src="https://tu.duoduocdn.com/uploads/day_260523/202605230307415472_720.jpg"> </div><p>名记罗马诺以标志性的“here we go”宣布，切尔西将签21岁斯特拉斯堡中场巴尔科。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-05-23/6a10cca8b7185native.htm" target="_blank" weibo="" mode="1,2">瓜帅：在曼城最大的遗憾是没给乔·哈特机会 有时我做得不够公平</a></p><div class="img_wrap" data-ratio="1.49" data="https://tu.duoduocdn.com/uploads/day_260523/202605230539002812.jpg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; te