 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="1.8" forbiden_android=">" t-rc="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg" alt="" src="http://tu.duoduocdn.com/uploads/day_250828/68af8038bb822.jpg"> </div><p><strong>【比赛战报】</strong></p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-23/match2067653date2026vnative.htm" target="_blank" weibo="" mode="1,2">补时绝杀！曼城2-1逆转伯恩茅斯 格伊建功格瓦绝杀谢尔基两助攻</a></p><div class="img_wrap" data-ratio="0.69" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260823/zhanbao_image_2067653_1787496959_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.69" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.69" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260823/zhanbao_image_2067653_1787496959_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260823/zhanbao_image_2067653_1787496959_gray.jpeg"> </div><p>格瓦迪奥尔补时绝杀，格伊头球破门！谢尔基替补两助攻，安德森伤退，蓝月逆转取得联赛开门红！</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-24/match2067654date2026vnative.htm" target="_blank" weibo="" mode="1,2">补时绝平！利物浦2-2纽卡 索博点射救主穆尼奥斯造点加克波贴地斩</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2067654_1787506159_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2067654_1787506159_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2067654_1787506159_gray.jpeg"> </div><p>穆尼奥斯补时造点，索博点射，加克波远射建功+失良机，威洛克、埃兰加破门，赫拉芬贝赫两度被断致后续丢球。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-23/match2067652date2026vnative.htm" target="_blank" weibo="" mode="1,2">暂登顶！布莱顿4-0十人维拉 辛谢尔伍德双响 若昂·戈麦斯直红</a></p><div class="img_wrap" data-ratio="0.64" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260823/zhanbao_image_2067652_1787496678_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.64" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.64" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260823/zhanbao_image_2067652_1787496678_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260823/zhanbao_image_2067652_1787496678_gray.jpeg"> </div><p>维拉31分钟连丢四球+全场0射正！林德洛夫乌龙，若昂·戈麦斯直红。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-24/match2075416date2026vnative.htm" target="_blank" weibo="" mode="1,2">巴萨5-0大胜埃尔切 拉菲尼亚2射1传 阿德耶米首秀破门 戈登2助攻</a></p><div class="img_wrap" data-ratio="0.62" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2075416_1787519913_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.62" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.62" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2075416_1787519913_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2075416_1787519913_gray.jpeg"> </div><p>拉菲尼亚2射1传，戈登替补2助，阿德耶米西甲首球，费尔明双响，加维半场伤退。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-24/match2075414date2026vnative.htm" target="_blank" weibo="" mode="1,2">两人送点！十人马竞2-2黄潜 小蜘蛛替补出战被嘘 小西蒙尼绝平</a></p><div class="img_wrap" data-ratio="0.67" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2075414_1787504032_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.67" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.67" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2075414_1787504032_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2075414_1787504032_gray.jpeg"> </div><p>阿尔瓦雷斯替补出场被嘘，马竞两送点球、勒诺尔芒送红点，普比尔、小西蒙尼破门。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-24/match2057386date2026vnative.htm" target="_blank" weibo="" mode="1,2">阿莫林首秀开门红！米兰2-1都灵 拉比奥传射19岁西塞精彩兜射破门</a></p><div class="img_wrap" data-ratio="0.63" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2057386_1787517628_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio="0.63" style="width: 100%; height: 200px; background: #eeeeee; line-height: 200px;  font-size: 1em;text-indent:-9999px;color: #A7A2A2; position: absolute;z-index: 2;">点击加载图片</div>     <img style="max-width: 100%; width: 100%; display: inline; height: 100%;" data-ratio="0.63" forbiden_android=">" t-rc="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2057386_1787517628_gray.jpeg" alt="" src="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2057386_1787517628_gray.jpeg"> </div><p>阿莫林首战告捷！小将西塞精彩兜射斩获处子球，拉比奥替补传射，丘库埃泽送助攻，亚当斯补时神仙球。</p><p><a href="https://news.zhibo8.cc/zuqiu/2026-08-24/match2057387date2026vnative.htm" target="_blank" weibo="" mode="1,2">开门红！尤文1-0弗洛西诺内 布雷默制胜 维卡里奥首秀补时伤退</a></p><div class="img_wrap" data-ratio="0.72" data="https://bbsimg.duoduocdn.com/bbsimg/shot/images/share_match_image/20260824/zhanbao_image_2057387_1787509483_gray.jpeg" data-thumb="" img_op="1_x|1_x|1_x|1_x" img_op_new="1_x|1_x|1_x|1_x" type="IMG" style="background-size: 100% 100%; width: 300px; height: 200px; margin: 0 auto; text-align: center; position: relative;">     <div class="play_btn" data-ratio=